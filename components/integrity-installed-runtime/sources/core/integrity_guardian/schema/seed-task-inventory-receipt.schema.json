{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/seed-task-inventory-receipt.schema.json",
  "title": "Canonical Seed task inventory receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "snapshot_id", "source_digest", "catalog_digest", "view", "selected_statuses", "status_counts", "returned_count", "has_more", "page_binding", "home_record_count", "production_authority", "route_authority", "receipt_id"],
  "properties": {
    "protocol": {"const": "integrity-guardian/seed-task-inventory-receipt/v1"},
    "snapshot_id": {"$ref": "#/$defs/digest"},
    "source_digest": {"$ref": "#/$defs/digest"},
    "catalog_digest": {"$ref": "#/$defs/digest"},
    "view": {"enum": ["work_queue_review", "failed"]},
    "selected_statuses": {
      "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
      "items": {"enum": ["active", "pending", "blocked", "unknown", "complete", "failed"]}
    },
    "status_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["active", "pending", "blocked", "unknown", "complete", "failed"],
      "properties": {
        "active": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "complete": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "returned_count": {"type": "integer", "minimum": 0, "maximum": 200},
    "has_more": {"type": "boolean"},
    "page_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["after_task_id", "limit", "next_after_task_id", "tasks_digest"],
      "properties": {
        "after_task_id": {"type": "string", "maxLength": 256},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200},
        "next_after_task_id": {"type": "string", "maxLength": 256},
        "tasks_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "home_record_count": {"const": 0},
    "production_authority": {"const": false},
    "route_authority": {"const": false},
    "receipt_id": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
