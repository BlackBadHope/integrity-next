{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/observation.schema.json",
  "title": "Guardian Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "observation_id",
    "tenant_id",
    "sensor_id",
    "node_id",
    "sequence",
    "observed_at",
    "layer",
    "subject",
    "evidence",
    "previous_observation_digest",
    "signature"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/observation/v1" },
    "observation_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "sensor_id": { "$ref": "#/$defs/id" },
    "node_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0 },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "layer": { "enum": ["L0", "L1", "L2", "L3"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": {
          "enum": [
            "node",
            "host",
            "network-interface",
            "route",
            "file",
            "directory",
            "package",
            "service",
            "policy",
            "behavior"
          ]
        },
        "identity": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "content_digest"],
      "properties": {
        "state": { "enum": ["present", "absent", "unknown", "sensor-gap"] },
        "content_digest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "integer", "boolean", "null"]
          }
        }
      }
    },
    "previous_observation_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
