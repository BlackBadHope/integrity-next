{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/toolz-reuse-readiness-receipt.schema.json",
  "title": "Integrity Uroboros Toolzs Reuse Readiness Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "receipt_id",
    "tenant_id",
    "policy_id",
    "policy_digest",
    "status",
    "tool_context",
    "evaluator",
    "witness",
    "feedback",
    "memory",
    "fog_route",
    "store",
    "timing",
    "authority_boundary",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/toolz-reuse-readiness-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^toolz-reuse-readiness-receipt:[a-f0-9]{64}$"
    },
    "tenant_id": {
      "const": "tenant:public-6e3cdbebaafc8efa"
    },
    "policy_id": {
      "$ref": "#/$defs/synthetic_id"
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "status": {
      "const": "ready-to-request-authorization"
    },
    "tool_context": {
      "$ref": "#/$defs/tool_context"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_id",
        "evaluator_artifact_digest"
      ],
      "properties": {
        "evaluator_id": {
          "$ref": "#/$defs/synthetic_id"
        },
        "evaluator_artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id",
        "witness_digest",
        "state_entity_id",
        "zone_id",
        "observed_at",
        "created_at"
      ],
      "properties": {
        "witness_id": {
          "type": "string",
          "pattern": "^toolz-start-state-witness:[a-f0-9]{64}$"
        },
        "witness_digest": {
          "$ref": "#/$defs/digest"
        },
        "state_entity_id": {
          "type": "string",
          "pattern": "^entity:synthetic-toolz-state-[a-f0-9]{64}$"
        },
        "zone_id": {
          "$ref": "#/$defs/synthetic_id"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_digest",
        "policy_digest",
        "decision"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^toolz-post-route-feedback-receipt:[a-f0-9]{64}$"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "decision": {
          "const": "admit-observed-success"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "theoretical_receipt_digest",
        "observed_receipt_id",
        "observed_receipt_digest",
        "outcome",
        "expires_at"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "pattern": "^toolz-store-context:[a-f0-9]{64}$"
        },
        "theoretical_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "observed_receipt_id": {
          "type": "string",
          "pattern": "^toolz-route-memory-receipt:[a-f0-9]{64}$"
        },
        "observed_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "outcome": {
          "const": "observed-success"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "fog_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "route_digest",
        "from_entity_id",
        "to_entity_id",
        "start_zone_id",
        "hop_count"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^discovery-(?:theory|feedback-ranked)-route:[a-f0-9]{64}$"
        },
        "route_digest": {
          "$ref": "#/$defs/digest"
        },
        "from_entity_id": {
          "$ref": "#/$defs/id"
        },
        "to_entity_id": {
          "$ref": "#/$defs/id"
        },
        "start_zone_id": {
          "$ref": "#/$defs/synthetic_id"
        },
        "hop_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "cursor",
        "generation",
        "lifecycle",
        "decision",
        "previous_receipt_digest"
      ],
      "properties": {
        "store_id": {
          "$ref": "#/$defs/store_id"
        },
        "cursor": {
          "$ref": "#/$defs/store_cursor"
        },
        "generation": {
          "const": 2
        },
        "lifecycle": {
          "const": "reusable"
        },
        "decision": {
          "const": "reuse-candidate"
        },
        "previous_receipt_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_at",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "evaluated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_granted",
        "authorization_requested",
        "browser_control",
        "credentials",
        "execution",
        "global_publish",
        "local_storage_read",
        "model_sdk",
        "network",
        "production_authority",
        "raw_ui_data",
        "storage_performed",
        "store_write",
        "tool_invocation"
      ],
      "properties": {
        "authorization_granted": {
          "const": false
        },
        "authorization_requested": {
          "const": false
        },
        "browser_control": {
          "const": false
        },
        "credentials": {
          "const": false
        },
        "execution": {
          "const": false
        },
        "global_publish": {
          "const": false
        },
        "local_storage_read": {
          "const": true
        },
        "model_sdk": {
          "const": false
        },
        "network": {
          "const": false
        },
        "production_authority": {
          "const": false
        },
        "raw_ui_data": {
          "const": false
        },
        "storage_performed": {
          "const": false
        },
        "store_write": {
          "const": false
        },
        "tool_invocation": {
          "const": false
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "synthetic_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "tool_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_digest",
        "environment_profile_id",
        "environment_fingerprint_digest",
        "ui_context_digest"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/synthetic_id"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "environment_profile_id": {
          "$ref": "#/$defs/synthetic_id"
        },
        "environment_fingerprint_digest": {
          "$ref": "#/$defs/digest"
        },
        "ui_context_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "store_id": {
      "type": "string",
      "pattern": "^toolz-store:[A-Za-z0-9][A-Za-z0-9._:/-]{0,242}$"
    },
    "store_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "tenant_id",
        "sequence",
        "manifest_id",
        "manifest_digest"
      ],
      "properties": {
        "store_id": {
          "$ref": "#/$defs/store_id"
        },
        "tenant_id": {
          "const": "tenant:public-6e3cdbebaafc8efa"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "manifest_id": {
          "type": "string",
          "pattern": "^toolz-route-store-manifest:[a-f0-9]{64}$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,128}$"
        }
      }
    }
  }
}
