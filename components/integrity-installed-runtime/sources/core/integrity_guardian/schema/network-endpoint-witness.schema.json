{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v2/network-endpoint-witness.schema.json",
  "title": "Integrity independent peer-authenticated network endpoint witness v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["witness_id", "protocol", "sdk_version", "action", "target", "executor", "observer", "observed", "result", "controls", "observed_at", "signer_id", "signature"],
  "properties": {
    "witness_id": { "type": "string", "pattern": "^network-endpoint-witness:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/network-endpoint-witness/v2" },
    "sdk_version": { "const": "1.0.0a2" },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "action_manifest_digest"],
      "properties": {
        "action_id": { "type": "string", "pattern": "^network-action:[a-f0-9]{64}$" },
        "action_manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "zone_id", "environment_digest", "endpoint_digest"],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "zone_id": { "$ref": "#/$defs/id" },
        "environment_digest": { "$ref": "#/$defs/digest" },
        "endpoint_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "executor": { "$ref": "#/$defs/actor" },
    "observer": { "$ref": "#/$defs/actor" },
    "observed": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "path_digest", "status", "content_type", "body_digest", "body_byte_count", "peer_receipt_id", "peer_receipt_digest", "peer_receipt", "peer_key_id", "peer_key_fingerprint", "raw_body_retained"],
      "properties": {
        "method": { "const": "GET" },
        "path_digest": { "$ref": "#/$defs/digest" },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "content_type": { "type": "string", "maxLength": 128 },
        "body_digest": { "$ref": "#/$defs/digest" },
        "body_byte_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "peer_receipt_id": { "type": "string", "pattern": "^network-peer-response:[a-f0-9]{64}$" },
        "peer_receipt_digest": { "$ref": "#/$defs/digest" },
        "peer_receipt": { "type": "object" },
        "peer_key_id": { "$ref": "#/$defs/id" },
        "peer_key_fingerprint": { "$ref": "#/$defs/digest" },
        "raw_body_retained": { "const": false }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_status_observed", "expected_content_type_observed", "expected_state_observed", "executor_claim_trusted", "external_causality_proven", "peer_authenticated"],
      "properties": {
        "expected_status_observed": { "type": "boolean" },
        "expected_content_type_observed": { "type": "boolean" },
        "expected_state_observed": { "type": "boolean" },
        "executor_claim_trusted": { "const": false },
        "external_causality_proven": { "const": false },
        "peer_authenticated": { "const": true }
      }
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["action_invocations", "read_only", "connection_count", "request_count", "numeric_loopback_destination", "dns_resolution", "proxy", "redirects", "credentials", "peer_authentication", "fresh_response_challenge_required", "home_input", "production_authority"],
      "properties": {
        "action_invocations": { "const": 0 },
        "read_only": { "const": true },
        "connection_count": { "const": 1 },
        "request_count": { "const": 1 },
        "numeric_loopback_destination": { "const": true },
        "dns_resolution": { "const": false },
        "proxy": { "const": false },
        "redirects": { "const": false },
        "credentials": { "const": false },
        "peer_authentication": { "const": "ed25519-challenge-v1" },
        "fresh_response_challenge_required": { "const": true },
        "home_input": { "const": false },
        "production_authority": { "const": false }
      }
    },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "artifact_digest", "key_id"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/id" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "key_id": { "$ref": "#/$defs/id" }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
