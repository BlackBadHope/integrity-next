{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-operation-binding.schema.json",
  "title": "Integrity Adapter SDK Signed Operation Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id", "protocol", "sdk_version", "tenant_id", "manifest",
    "conformance", "intent", "operation", "executor", "controls",
    "created_at", "signer_id", "signature"
  ],
  "properties": {
    "binding_id": { "type": "string", "pattern": "^adapter-operation-binding:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/adapter-operation-binding/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "tenant_id": { "const": "tenant:public-6e3cdbebaafc8efa" },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "manifest_digest", "adapter_id", "adapter_artifact_digest"],
      "properties": {
        "manifest_id": { "type": "string", "pattern": "^manifest:[a-f0-9]{64}$" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "adapter_id": { "$ref": "#/$defs/id" },
        "adapter_artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "conformance": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "receipt_digest", "readiness"],
      "properties": {
        "receipt_id": { "type": "string", "pattern": "^adapter-conformance-receipt:[a-f0-9]{64}$" },
        "receipt_digest": { "$ref": "#/$defs/digest" },
        "readiness": { "enum": ["source-ready", "target-live-ready", "portfolio-ready"] }
      }
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_digest", "action_class", "target_entity_id", "target_zone_id"],
      "properties": {
        "operation_digest": { "$ref": "#/$defs/digest" },
        "action_class": { "enum": ["observe", "navigate", "activate", "input", "submit", "wait", "external-call"] },
        "target_entity_id": { "$ref": "#/$defs/id" },
        "target_zone_id": { "$ref": "#/$defs/id" }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "manifest_id", "manifest_digest", "target_node_id"],
      "properties": {
        "kind": { "enum": ["readonly-operation-manifest", "adapter-target-operation"] },
        "manifest_id": { "type": "string", "pattern": "^(?:operation-manifest|adapter-target-operation):[a-f0-9]{64}$" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "target_node_id": { "$ref": "#/$defs/id" }
      }
    },
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_id", "executor_artifact_digest", "key_id"],
      "properties": {
        "executor_id": { "$ref": "#/$defs/id" },
        "executor_artifact_digest": { "$ref": "#/$defs/digest" },
        "key_id": { "$ref": "#/$defs/id" }
      }
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["max_invocations", "binding_substitution_allowed", "automatic_retry_after_unknown", "memory_write", "production_authority"],
      "properties": {
        "max_invocations": { "const": 1 },
        "binding_substitution_allowed": { "const": false },
        "automatic_retry_after_unknown": { "const": false },
        "memory_write": { "const": false },
        "production_authority": { "const": false }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
