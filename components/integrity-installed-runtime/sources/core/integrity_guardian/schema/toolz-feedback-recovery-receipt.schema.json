{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/toolz-feedback-recovery-receipt.schema.json",
  "title": "Integrity Uroboros Toolzs Feedback Recovery Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "receipt_id",
    "tenant_id",
    "policy_id",
    "policy_digest",
    "install_policy_digest",
    "feedback",
    "theoretical_memory",
    "observed_memory",
    "store",
    "timing",
    "authority_boundary",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/toolz-feedback-recovery-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^toolz-feedback-recovery-receipt:[a-f0-9]{64}$"
    },
    "tenant_id": {
      "const": "tenant:public-6e3cdbebaafc8efa"
    },
    "policy_id": {
      "$ref": "#/$defs/synthetic_id"
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "install_policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_digest",
        "policy_id",
        "policy_digest",
        "decision",
        "created_at"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^toolz-post-route-feedback-receipt:[a-f0-9]{64}$"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_id": {
          "$ref": "#/$defs/synthetic_id"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "decision": {
          "const": "admit-observed-success"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "theoretical_memory": {
      "$ref": "#/$defs/theoretical_memory"
    },
    "observed_memory": {
      "$ref": "#/$defs/observed_memory"
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "retained_cursor",
        "recovered_cursor",
        "status",
        "maximum_descendant_distance",
        "recovered_manifest_created_at",
        "required_predecessor",
        "expected_promoted_entry"
      ],
      "properties": {
        "store_id": {
          "$ref": "#/$defs/store_id"
        },
        "retained_cursor": {
          "$ref": "#/$defs/store_cursor"
        },
        "recovered_cursor": {
          "$ref": "#/$defs/store_cursor"
        },
        "status": {
          "enum": [
            "retained-head",
            "recovered-feedback-install"
          ]
        },
        "maximum_descendant_distance": {
          "const": 1
        },
        "recovered_manifest_created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "required_predecessor": {
          "$ref": "#/$defs/predecessor_entry"
        },
        "expected_promoted_entry": {
          "$ref": "#/$defs/result_entry"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_at",
        "recovered_at"
      ],
      "properties": {
        "evaluated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "recovered_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_control",
        "credentials",
        "execution",
        "feedback_install_receipt_reconstruction",
        "generic_newest_head",
        "global_publish",
        "historical_feedback_install_invocation",
        "local_storage",
        "model_sdk",
        "network",
        "production_authority",
        "raw_ui_data",
        "rollback_bypass",
        "store_write",
        "tool_invocation"
      ],
      "properties": {
        "browser_control": {
          "const": false
        },
        "credentials": {
          "const": false
        },
        "execution": {
          "const": false
        },
        "feedback_install_receipt_reconstruction": {
          "const": false
        },
        "generic_newest_head": {
          "const": false
        },
        "global_publish": {
          "const": false
        },
        "historical_feedback_install_invocation": {
          "const": false
        },
        "local_storage": {
          "const": true
        },
        "model_sdk": {
          "const": false
        },
        "network": {
          "const": false
        },
        "production_authority": {
          "const": false
        },
        "raw_ui_data": {
          "const": false
        },
        "rollback_bypass": {
          "const": false
        },
        "store_write": {
          "const": false
        },
        "tool_invocation": {
          "const": false
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "synthetic_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}synthetic[A-Za-z0-9._:/-]*$"
    },
    "store_id": {
      "type": "string",
      "pattern": "^toolz-store:[A-Za-z0-9][A-Za-z0-9._:/-]{0,242}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "context_id": {
      "type": "string",
      "pattern": "^toolz-store-context:[a-f0-9]{64}$"
    },
    "memory_receipt_id": {
      "type": "string",
      "pattern": "^toolz-route-memory-receipt:[a-f0-9]{64}$"
    },
    "theoretical_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_digest",
        "context_id",
        "outcome",
        "observed_at",
        "evidence_digest",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/memory_receipt_id"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "context_id": {
          "$ref": "#/$defs/context_id"
        },
        "outcome": {
          "const": "theoretical"
        },
        "observed_at": {
          "type": "null"
        },
        "evidence_digest": {
          "type": "null"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "observed_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_digest",
        "context_id",
        "outcome",
        "observed_at",
        "evidence_digest",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/memory_receipt_id"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "context_id": {
          "$ref": "#/$defs/context_id"
        },
        "outcome": {
          "const": "observed-success"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "predecessor_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "generation",
        "receipt_id",
        "receipt_digest",
        "previous_receipt_digest",
        "lifecycle",
        "decision",
        "invalidation_reason"
      ],
      "properties": {
        "context_id": {
          "$ref": "#/$defs/context_id"
        },
        "generation": {
          "const": 1
        },
        "receipt_id": {
          "$ref": "#/$defs/memory_receipt_id"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "previous_receipt_digest": {
          "type": "null"
        },
        "lifecycle": {
          "const": "theoretical"
        },
        "decision": {
          "const": "explore"
        },
        "invalidation_reason": {
          "type": "null"
        }
      }
    },
    "result_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "generation",
        "receipt_id",
        "receipt_digest",
        "previous_receipt_digest",
        "lifecycle",
        "decision",
        "invalidation_reason"
      ],
      "properties": {
        "context_id": {
          "$ref": "#/$defs/context_id"
        },
        "generation": {
          "const": 2
        },
        "receipt_id": {
          "$ref": "#/$defs/memory_receipt_id"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "previous_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "lifecycle": {
          "const": "reusable"
        },
        "decision": {
          "const": "reuse-candidate"
        },
        "invalidation_reason": {
          "type": "null"
        }
      }
    },
    "store_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "tenant_id",
        "sequence",
        "manifest_id",
        "manifest_digest"
      ],
      "properties": {
        "store_id": {
          "$ref": "#/$defs/store_id"
        },
        "tenant_id": {
          "const": "tenant:public-6e3cdbebaafc8efa"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "manifest_id": {
          "type": "string",
          "pattern": "^toolz-route-store-manifest:[a-f0-9]{64}$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^key:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
