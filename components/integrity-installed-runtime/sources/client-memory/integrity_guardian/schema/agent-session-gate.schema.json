{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/agent-session-gate.schema.json",
  "title": "Integrity agent session gate decision v1",
  "description": "Default-deny decision for one Integrity-mediated or wrapper-gated tool. Not production authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "decision",
    "reason",
    "tool",
    "surface",
    "agent_id",
    "principal_id",
    "admission_id",
    "production_authority",
    "evaluated_at"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/agent-session-gate/v1" },
    "decision": { "enum": ["allow", "deny"] },
    "reason": {
      "enum": [
        "allowed",
        "session-missing",
        "session-expired",
        "session-scope-mismatch",
        "principal-missing",
        "principal-mismatch",
        "capability-missing",
        "conflicting-identity",
        "policy-bypass"
      ]
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "surface": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^(agent:[a-f0-9]{64})?$"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^(reader:[a-f0-9]{64})?$"
    },
    "admission_id": {
      "type": "string",
      "pattern": "^(admission:[a-f0-9]{64})?$"
    },
    "production_authority": { "const": false },
    "evaluated_at": { "type": "string", "format": "date-time" }
  }
}
