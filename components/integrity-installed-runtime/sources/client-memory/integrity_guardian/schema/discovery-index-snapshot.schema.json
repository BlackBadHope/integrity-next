{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/discovery-index-snapshot.schema.json",
  "title": "Integrity Fog of War Discovery Index Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "snapshot_id",
    "tenant_id",
    "created_at",
    "snapshot_sequence",
    "previous_snapshot_digest",
    "active_state_digest",
    "trusted_sources",
    "source_tips",
    "active_records",
    "index_boundary",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/discovery-index-snapshot/v1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^discovery-index-snapshot:[a-f0-9]{64}$"
    },
    "tenant_id": { "$ref": "#/$defs/tenant_id" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "snapshot_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "previous_snapshot_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "active_state_digest": { "$ref": "#/$defs/digest" },
    "trusted_sources": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/trusted_source" }
    },
    "source_tips": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source_tip" }
    },
    "active_records": {
      "type": "array",
      "maxItems": 25000,
      "items": {
        "type": "object"
      }
    },
    "admission_state": {
      "$ref": "#/$defs/admission_state"
    },
    "index_boundary": { "$ref": "#/$defs/index_boundary" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant:[A-Za-z0-9][A-Za-z0-9._:/-]{0,248}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "trusted_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_epoch",
        "source_artifact_digest",
        "key_id",
        "public_key_fingerprint"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "source_epoch": { "$ref": "#/$defs/id" },
        "source_artifact_digest": { "$ref": "#/$defs/digest" },
        "key_id": { "$ref": "#/$defs/id" },
        "public_key_fingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "source_tip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_epoch",
        "sequence",
        "record_digest",
        "source_artifact_digest",
        "record"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "source_epoch": { "$ref": "#/$defs/id" },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "record_digest": { "$ref": "#/$defs/digest" },
        "source_artifact_digest": { "$ref": "#/$defs/digest" },
        "record": {
          "type": "object"
        }
      }
    },
    "admission_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_digest",
        "semantic_history"
      ],
      "properties": {
        "policy_digest": { "$ref": "#/$defs/digest" },
        "semantic_history": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "$ref": "#/$defs/semantic_history_entry"
          }
        }
      }
    },
    "semantic_history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "assertion_kind",
        "assertion_id",
        "semantic_identity"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "assertion_kind": {
          "enum": ["entity", "relation", "gap"]
        },
        "assertion_id": { "$ref": "#/$defs/id" },
        "semantic_identity": {
          "type": "string",
          "pattern": "^discovery-semantic:[a-f0-9]{64}$"
        }
      }
    },
    "index_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_performed",
        "model_calls",
        "network",
        "production_authority",
        "tool_calls"
      ],
      "properties": {
        "execution_performed": { "const": false },
        "model_calls": { "const": 0 },
        "network": { "const": false },
        "production_authority": { "const": false },
        "tool_calls": { "const": 0 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,128}$"
        }
      }
    }
  }
}
