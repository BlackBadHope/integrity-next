{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/change-intent.schema.json",
  "title": "Guardian ChangeIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "intent_id",
    "tenant_id",
    "actor",
    "target",
    "scope",
    "expected_changes",
    "created_at",
    "valid_from",
    "valid_until",
    "authorization"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/change-intent/v1" },
    "intent_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "kind"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["human", "service", "ai-agent"] },
        "session_id": { "$ref": "#/$defs/id" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id"],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "adapter_id": { "$ref": "#/$defs/id" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectors", "operations"],
      "properties": {
        "selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["create", "update-content", "update-metadata", "delete", "execute"]
          }
        }
      }
    },
    "expected_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "operation", "before_digest", "after_digest"],
        "properties": {
          "selector": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "operation": {
            "enum": ["create", "update-content", "update-metadata", "delete", "execute"]
          },
          "before_digest": {
            "oneOf": [
              { "$ref": "#/$defs/digest" },
              { "type": "null" }
            ]
          },
          "after_digest": {
            "oneOf": [
              { "$ref": "#/$defs/digest" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "valid_until": { "$ref": "#/$defs/timestamp" },
    "retrospective": { "type": "boolean", "default": false },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "decision", "signature"],
      "properties": {
        "authority_id": { "$ref": "#/$defs/id" },
        "decision": { "const": "approved" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "enum": ["ed25519"] },
        "key_id": { "$ref": "#/$defs/id" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,128}$"
        }
      }
    }
  }
}
