{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/customer-policy-binding.schema.json",
  "title": "Integrity Customer Policy Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "binding_id",
    "tenant_id",
    "policy_digest",
    "valid_from",
    "valid_until",
    "authority_id",
    "production_authority",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/customer-policy-binding/v1"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^policy-binding:[a-f0-9]{64}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant:[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "production_authority": {
      "const": false
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,128}$"
        }
      }
    }
  }
}
