{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-action-proposal.schema.json",
  "title": "Integrity Adapter SDK Action Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id", "protocol", "sdk_version", "tenant_id", "manifest", "proposer",
    "intent", "expected_transition", "required_channels", "scope", "proposed_at",
    "expires_at", "signer_id", "signature"
  ],
  "properties": {
    "proposal_id": { "type": "string", "pattern": "^proposal:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/adapter-action-proposal/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "tenant_id": { "const": "tenant:public-6e3cdbebaafc8efa" },
    "manifest": { "$ref": "#/$defs/manifest_ref" },
    "proposer": {
      "type": "object", "additionalProperties": false,
      "required": ["proposer_id", "proposer_artifact_digest"],
      "properties": {
        "proposer_id": { "$ref": "#/$defs/id" },
        "proposer_artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "intent": { "$ref": "#/$defs/intent" },
    "expected_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["state_digest", "entity_id", "zone_id"],
      "properties": {
        "state_digest": { "$ref": "#/$defs/digest" },
        "entity_id": { "$ref": "#/$defs/id" },
        "zone_id": { "$ref": "#/$defs/id" }
      }
    },
    "required_channels": { "$ref": "#/$defs/channels" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["max_transitions", "replay_allowed", "automatic_retry_after_unknown", "production_authority_requested"],
      "properties": {
        "max_transitions": { "const": 1 },
        "replay_allowed": { "const": false },
        "automatic_retry_after_unknown": { "const": false },
        "production_authority_requested": { "const": false }
      }
    },
    "proposed_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "action_class": { "enum": ["observe", "navigate", "activate", "input", "submit", "wait", "external-call"] },
    "manifest_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "manifest_digest", "adapter_id", "adapter_artifact_digest"],
      "properties": {
        "manifest_id": { "type": "string", "pattern": "^manifest:[a-f0-9]{64}$" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "adapter_id": { "$ref": "#/$defs/id" },
        "adapter_artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["route_proposal_id", "route_digest", "hop_index", "action_class", "operation_digest", "relation_id", "from_entity_id", "to_entity_id", "from_zone_id", "to_zone_id"],
      "properties": {
        "route_proposal_id": { "type": "string", "pattern": "^discovery-(?:theory|feedback-ranked)-route:[a-f0-9]{64}$" },
        "route_digest": { "$ref": "#/$defs/digest" },
        "hop_index": { "const": 0 },
        "action_class": { "$ref": "#/$defs/action_class" },
        "operation_digest": { "$ref": "#/$defs/digest" },
        "relation_id": { "$ref": "#/$defs/id" },
        "from_entity_id": { "$ref": "#/$defs/id" },
        "to_entity_id": { "$ref": "#/$defs/id" },
        "from_zone_id": { "$ref": "#/$defs/id" },
        "to_zone_id": { "$ref": "#/$defs/id" }
      }
    },
    "channels": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "browser_control", "computer_use", "credentials", "network", "service_control", "shell"],
      "properties": {
        "api": { "type": "boolean" }, "browser_control": { "type": "boolean" },
        "computer_use": { "type": "boolean" }, "credentials": { "type": "boolean" },
        "network": { "type": "boolean" }, "service_control": { "type": "boolean" },
        "shell": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" }, "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
