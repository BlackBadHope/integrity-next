{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/credential-custody-receipt.schema.json",
  "title": "Credential custody audit receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "audited_at",
    "state_root",
    "state_inventory_digest",
    "source_file_count",
    "secret_candidate_count",
    "scanned_file_count",
    "scanned_byte_count",
    "credential_named_file_count",
    "secret_value_match_count",
    "values_emitted",
    "value_digests_emitted",
    "bounded",
    "production_authority"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/credential-custody-receipt/v1" },
    "status": { "enum": ["PASS", "FAIL"] },
    "audited_at": { "type": "string", "format": "date-time" },
    "state_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "state_inventory_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_file_count": { "type": "integer", "minimum": 1, "maximum": 32 },
    "secret_candidate_count": { "type": "integer", "minimum": 0 },
    "scanned_file_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "scanned_byte_count": { "type": "integer", "minimum": 0, "maximum": 67108864 },
    "credential_named_file_count": { "type": "integer", "minimum": 0 },
    "secret_value_match_count": { "type": "integer", "minimum": 0 },
    "values_emitted": { "const": false },
    "value_digests_emitted": { "const": false },
    "bounded": { "const": true },
    "production_authority": { "const": false }
  }
}
