{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/discovery-feedback-overlay-delta.schema.json",
  "title": "Integrity Fog of War Feedback Overlay Delta v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "delta_id",
    "tenant_id",
    "snapshot_id",
    "snapshot_digest",
    "theory_policy_id",
    "theory_policy_digest",
    "feedback_policy_id",
    "feedback_policy_digest",
    "sequence",
    "previous_delta_digest",
    "previous_overlay_id",
    "previous_overlay_digest",
    "next_overlay_id",
    "next_overlay_digest",
    "created_at",
    "added_feedback_receipt_ids",
    "changed_record_ids",
    "changed_feedback_score_record_ids",
    "newly_excluded_record_ids",
    "newly_invalidated_zone_ids",
    "newly_invalidated_proposal_ids",
    "widened_invalidation_proposal_ids",
    "recheck_record_ids",
    "recheck_zone_ids",
    "recheck_proposal_ids",
    "delta_boundary",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/discovery-feedback-overlay-delta/v1"
    },
    "delta_id": {
      "type": "string",
      "pattern": "^discovery-feedback-overlay-delta:[a-f0-9]{64}$"
    },
    "tenant_id": { "$ref": "#/$defs/tenant_id" },
    "snapshot_id": {
      "type": "string",
      "pattern": "^discovery-index-snapshot:[a-f0-9]{64}$"
    },
    "snapshot_digest": { "$ref": "#/$defs/digest" },
    "theory_policy_id": { "$ref": "#/$defs/id" },
    "theory_policy_digest": { "$ref": "#/$defs/digest" },
    "feedback_policy_id": { "$ref": "#/$defs/id" },
    "feedback_policy_digest": { "$ref": "#/$defs/digest" },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "previous_delta_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "previous_overlay_id": { "$ref": "#/$defs/overlay_id" },
    "previous_overlay_digest": { "$ref": "#/$defs/digest" },
    "next_overlay_id": { "$ref": "#/$defs/overlay_id" },
    "next_overlay_digest": { "$ref": "#/$defs/digest" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "added_feedback_receipt_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/receipt_id" }
    },
    "changed_record_ids": { "$ref": "#/$defs/record_ids" },
    "changed_feedback_score_record_ids": { "$ref": "#/$defs/record_ids" },
    "newly_excluded_record_ids": { "$ref": "#/$defs/record_ids" },
    "newly_invalidated_zone_ids": { "$ref": "#/$defs/zone_ids" },
    "newly_invalidated_proposal_ids": { "$ref": "#/$defs/proposal_ids" },
    "widened_invalidation_proposal_ids": { "$ref": "#/$defs/proposal_ids" },
    "recheck_record_ids": { "$ref": "#/$defs/record_ids" },
    "recheck_zone_ids": { "$ref": "#/$defs/zone_ids" },
    "recheck_proposal_ids": { "$ref": "#/$defs/proposal_ids" },
    "delta_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentials",
        "execution",
        "model_sdk",
        "network",
        "production_authority",
        "source_evidence_mutated",
        "synapse_authority"
      ],
      "properties": {
        "credentials": { "const": false },
        "execution": { "const": false },
        "model_sdk": { "const": false },
        "network": { "const": false },
        "production_authority": { "const": false },
        "source_evidence_mutated": { "const": false },
        "synapse_authority": { "const": false }
      }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant:[A-Za-z0-9][A-Za-z0-9._:/-]{0,248}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "overlay_id": {
      "type": "string",
      "pattern": "^discovery-feedback-overlay:[a-f0-9]{64}$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^discovery-theory-feedback:[a-f0-9]{64}$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^discovery-record:[a-f0-9]{64}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^discovery-theory-route:[a-f0-9]{64}$"
    },
    "record_ids": {
      "type": "array",
      "maxItems": 25000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/record_id" }
    },
    "zone_ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "proposal_ids": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/proposal_id" }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,128}$"
        }
      }
    }
  }
}
