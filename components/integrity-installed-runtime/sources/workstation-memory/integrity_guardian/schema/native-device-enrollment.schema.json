{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/native-device-enrollment.schema.json",
  "title": "Integrity native device enrollment",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "instance_id", "device_id", "public_key", "scopes", "created_at", "enrollment_id", "signature"],
  "properties": {
    "protocol": { "const": "integrity-guardian/native-device-enrollment/v1" },
    "instance_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "device_id": { "type": "string", "pattern": "^device:[A-Za-z0-9._:-]+$" },
    "public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "scopes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" } },
    "created_at": { "type": "string", "format": "date-time" },
    "enrollment_id": { "$ref": "#/$defs/digest" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
