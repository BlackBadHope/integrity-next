{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/agent-identity.schema.json",
  "title": "Integrity runtime agent identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "agent_id",
    "kind",
    "vendor",
    "product",
    "runtime",
    "instance_id"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/agent-identity/v1" },
    "agent_id": {
      "type": "string",
      "pattern": "^agent:[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": ["coding-agent", "human", "automation", "unknown"]
    },
    "vendor": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "product": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "runtime": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
