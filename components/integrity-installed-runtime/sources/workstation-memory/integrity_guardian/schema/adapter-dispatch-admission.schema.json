{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-dispatch-admission.schema.json",
  "title": "Integrity Adapter Dispatch Admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_id", "protocol", "tenant_id", "registry", "envelope",
    "attempt", "controls", "recorded_at", "signer_id", "signature"
  ],
  "properties": {
    "admission_id": {
      "type": "string",
      "pattern": "^adapter-dispatch-admission:[a-f0-9]{64}$"
    },
    "protocol": { "const": "integrity-guardian/adapter-dispatch-admission/v1" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "key_id", "key_fingerprint"],
      "properties": {
        "registry_id": {
          "type": "string",
          "pattern": "^adapter-dispatch-registry:[a-f0-9]{64}$"
        },
        "key_id": { "$ref": "#/$defs/id" },
        "key_fingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_id", "envelope_digest"],
      "properties": {
        "envelope_id": {
          "type": "string",
          "pattern": "^envelope:[a-f0-9]{64}$"
        },
        "envelope_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "store_digest", "journal_key_id",
        "journal_key_fingerprint", "checkpoint_key_id",
        "checkpoint_key_fingerprint"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^adapter-attempt:[a-f0-9]{64}$"
        },
        "store_digest": { "$ref": "#/$defs/digest" },
        "journal_key_id": { "$ref": "#/$defs/id" },
        "journal_key_fingerprint": { "$ref": "#/$defs/digest" },
        "checkpoint_key_id": { "$ref": "#/$defs/id" },
        "checkpoint_key_fingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_invocations", "action_replay_allowed", "production_authority"],
      "properties": {
        "max_invocations": { "const": 1 },
        "action_replay_allowed": { "const": false },
        "production_authority": { "const": false }
      }
    },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
