{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-portability-receipt.schema.json",
  "title": "Integrity ASDK portability receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "protocol", "sdk_version", "manifest", "receipt_model_digest", "evidence", "result", "authority_boundary", "created_at", "signer_id", "signature"],
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^adapter-portability-receipt:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/adapter-portability-receipt/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "receipt_model_digest": { "$ref": "#/$defs/digest" },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "evidence_id", "evidence_digest", "environment_digest", "architecture"],
        "properties": {
          "family": { "enum": ["linux", "windows", "macos"] },
          "evidence_id": { "type": "string", "pattern": "^adapter-platform-lifecycle-evidence:[a-f0-9]{64}$" },
          "evidence_digest": { "$ref": "#/$defs/digest" },
          "environment_digest": { "$ref": "#/$defs/digest" },
          "architecture": { "$ref": "#/$defs/id" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["families", "lifecycle_complete", "same_receipt_model", "readiness"],
      "properties": {
        "families": {
          "type": "array",
          "prefixItems": [
            { "const": "linux" },
            { "const": "windows" },
            { "const": "macos" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "lifecycle_complete": { "const": true },
        "same_receipt_model": { "const": true },
        "readiness": { "const": "portable-lifecycle-ready" }
      }
    },
    "authority_boundary": { "$ref": "#/$defs/authority" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "manifest_digest", "adapter_id", "adapter_artifact_digest"],
      "properties": {
        "manifest_id": { "type": "string", "pattern": "^manifest:[a-f0-9]{64}$" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "adapter_id": { "$ref": "#/$defs/id" },
        "adapter_artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues_grants", "executes_actions", "memory_write", "production_authority"],
      "properties": {
        "issues_grants": { "const": false },
        "executes_actions": { "const": false },
        "memory_write": { "const": false },
        "production_authority": { "const": false }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
