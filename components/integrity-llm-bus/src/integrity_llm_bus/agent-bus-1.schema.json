{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/agent-bus-1.schema.json",
  "title": "Integrity agent bus message v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "from", "to", "k", "th", "delivery", "body", "body_sha256", "created_utc"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "from": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "to": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "k": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,63}$"},
    "th": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "reply_to": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "delivery": {"type": "string", "enum": ["steer", "queue", "pull"]},
    "body": {"type": "string", "minLength": 1},
    "body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
