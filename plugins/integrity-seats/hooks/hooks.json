{
  "description": "Owner-installed Integrity client profile; requires explicit INTEGRITY_CLIENT_MEMORY_CONFIG and fresh bindings.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory linux/admission --event SessionStart",
            "commandWindows": "integrity-client-memory windows/admission --event SessionStart",
            "timeout": 45,
            "statusMessage": "Integrity capability and snapshot admission"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory common/integrity_scope_synapse --harness codex --event SessionStart",
            "commandWindows": "integrity-client-memory common/integrity_scope_synapse --harness codex --event SessionStart",
            "timeout": 20,
            "statusMessage": "Integrity scope synapse delivery after compaction"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory linux/admission --event UserPromptSubmit",
            "commandWindows": "integrity-client-memory windows/admission --event UserPromptSubmit",
            "timeout": 45,
            "statusMessage": "Integrity Mind Graph and architecture admission"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory common/integrity_scope_synapse --harness codex --event UserPromptSubmit",
            "commandWindows": "integrity-client-memory common/integrity_scope_synapse --harness codex --event UserPromptSubmit",
            "timeout": 20,
            "statusMessage": "Integrity scope anchor from the owner prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory linux/admission --event PreToolUse",
            "commandWindows": "integrity-client-memory windows/admission --event PreToolUse",
            "timeout": 10,
            "statusMessage": "Integrity admission and mutation gate"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory common/integrity_scope_synapse --harness codex --event PreToolUse",
            "commandWindows": "integrity-client-memory common/integrity_scope_synapse --harness codex --event PreToolUse",
            "timeout": 20,
            "statusMessage": "Integrity scope reflex after compaction"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory linux/admission --event PostToolUse",
            "commandWindows": "integrity-client-memory windows/admission --event PostToolUse",
            "timeout": 60,
            "statusMessage": "Integrity outcome and closure witness"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory linux/admission --event SubagentStart",
            "commandWindows": "integrity-client-memory windows/admission --event SubagentStart",
            "timeout": 45,
            "statusMessage": "Integrity subagent architecture admission"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory linux/admission --event Stop",
            "commandWindows": "integrity-client-memory windows/admission --event Stop",
            "timeout": 60,
            "statusMessage": "Integrity admission and closure check"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory linux/admission --event SubagentStop",
            "commandWindows": "integrity-client-memory windows/admission --event SubagentStop",
            "timeout": 60,
            "statusMessage": "Integrity subagent closure check"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory common/integrity_scope_synapse --harness codex --event PreCompact",
            "commandWindows": "integrity-client-memory common/integrity_scope_synapse --harness codex --event PreCompact",
            "timeout": 20,
            "statusMessage": "Integrity scope synapse arming before compaction"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "integrity-client-memory common/integrity_scope_synapse --harness codex --event PostCompact",
            "commandWindows": "integrity-client-memory common/integrity_scope_synapse --harness codex --event PostCompact",
            "timeout": 20,
            "statusMessage": "Integrity scope synapse arming after compaction"
          }
        ]
      }
    ]
  }
}
