{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/module-agent-handoff-reconciliation-receipt.schema.json",
  "title": "Module Agent Handoff Reconciliation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "receipt_id", "transaction_id", "request_digest", "store_id", "tenant_id", "module_id", "signer_policy_digest", "status", "commit_receipt_id", "observed_head_id", "observed_head_digest", "observed_fence_token", "reconciled_at", "retry_permitted", "production_authority", "signature"],
  "properties": {
    "protocol": { "const": "integrity-guardian/module-agent-handoff-reconciliation-receipt/v1" },
    "receipt_id": { "type": "string", "pattern": "^handoff-reconciliation:[a-f0-9]{64}$" },
    "transaction_id": { "type": "string", "pattern": "^handoff-tx:[a-f0-9]{64}$" },
    "request_digest": { "$ref": "#/$defs/digest" },
    "store_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/tenant_id" },
    "module_id": { "$ref": "#/$defs/id" },
    "signer_policy_digest": { "$ref": "#/$defs/digest" },
    "status": { "enum": ["COMMITTED", "NOT_COMMITTED"] },
    "commit_receipt_id": { "oneOf": [{ "type": "string", "pattern": "^handoff-commit:[a-f0-9]{64}$" }, { "type": "null" }] },
    "observed_head_id": { "$ref": "#/$defs/id" },
    "observed_head_digest": { "$ref": "#/$defs/digest" },
    "observed_fence_token": { "type": "integer", "minimum": 0 },
    "reconciled_at": { "type": "string", "format": "date-time" },
    "retry_permitted": { "const": false },
    "production_authority": { "const": false },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "COMMITTED" } } }, "then": { "properties": { "commit_receipt_id": { "type": "string", "pattern": "^handoff-commit:[a-f0-9]{64}$" } } } },
    { "if": { "properties": { "status": { "const": "NOT_COMMITTED" } } }, "then": { "properties": { "commit_receipt_id": { "type": "null" } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "tenant_id": { "type": "string", "pattern": "^tenant:[A-Za-z0-9][A-Za-z0-9._:/-]{0,248}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": { "algorithm": { "const": "ed25519" }, "key_id": { "$ref": "#/$defs/id" }, "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" } } }
  }
}
