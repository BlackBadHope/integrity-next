{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/cognitive-continuation-receipt.schema.json",
  "title": "Atlas Cognitive Continuation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "receipt_id",
    "package_id",
    "package_digest",
    "tenant_id",
    "module_id",
    "agent_id",
    "generation",
    "lease_id",
    "event_cursor",
    "resumed_model_id",
    "accepted",
    "agent_key_id",
    "production_authority",
    "signature"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/cognitive-continuation-receipt/v1" },
    "receipt_id": {
      "type": "string",
      "pattern": "^continuation-receipt:[a-f0-9]{64}$"
    },
    "package_id": { "$ref": "#/$defs/id" },
    "package_digest": { "$ref": "#/$defs/digest" },
    "tenant_id": { "$ref": "#/$defs/tenant_id" },
    "module_id": { "$ref": "#/$defs/id" },
    "agent_id": { "$ref": "#/$defs/id" },
    "generation": { "type": "integer", "minimum": 0 },
    "lease_id": { "$ref": "#/$defs/id" },
    "event_cursor": { "type": "integer", "minimum": 0 },
    "resumed_model_id": { "$ref": "#/$defs/id" },
    "accepted": { "const": true },
    "agent_key_id": { "$ref": "#/$defs/id" },
    "production_authority": { "const": false },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant:[A-Za-z0-9][A-Za-z0-9._:/-]{0,248}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
