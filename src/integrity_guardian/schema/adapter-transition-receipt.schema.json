{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-transition-receipt.schema.json",
  "title": "Integrity Adapter SDK Terminal Transition Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "protocol", "sdk_version", "tenant_id", "manifest", "proposal", "envelope", "operation_binding", "authorization", "execution", "witness", "result", "memory", "authority_boundary", "recorded_at", "signer_id", "signature"],
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^receipt:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/adapter-transition-receipt/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "tenant_id": { "const": "tenant:public-6e3cdbebaafc8efa" },
    "manifest": { "$ref": "#/$defs/manifest_ref" },
    "proposal": { "$ref": "#/$defs/proposal_ref" },
    "envelope": { "oneOf": [{ "$ref": "#/$defs/envelope_ref" }, { "type": "null" }] },
    "operation_binding": { "oneOf": [{ "$ref": "#/$defs/operation_binding_ref" }, { "type": "null" }] },
    "authorization": { "oneOf": [{ "$ref": "#/$defs/authorization" }, { "type": "null" }] },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["grant_consumed", "invocation_started", "executor", "adapter_reported_outcome", "adapter_evidence_digest"],
      "properties": {
        "grant_consumed": { "type": "boolean" }, "invocation_started": { "type": "boolean" },
        "executor": { "oneOf": [{ "$ref": "#/$defs/executor" }, { "type": "null" }] },
        "adapter_reported_outcome": { "oneOf": [{ "enum": ["reported-success", "reported-failure", "outcome-unknown"] }, { "type": "null" }] },
        "adapter_evidence_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    },
    "witness": { "oneOf": [{ "$ref": "#/$defs/witness" }, { "type": "null" }] },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "reason_code", "action_replayed", "automatic_retry_allowed"],
      "properties": {
        "outcome": { "enum": ["not-started", "grant-consumed-action-not-started", "confirmed-success", "confirmed-failure", "unknown-outcome"] },
        "reason_code": { "enum": ["grant-not-consumed", "preflight-stopped-after-consumption", "witness-or-executor-unknown", "independent-observation-unknown", "executor-and-witness-agree", "witness-rejects-transition", "executor-witness-disagree"] },
        "action_replayed": { "const": false }, "automatic_retry_allowed": { "type": "boolean" }
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["feedback_receipt_required_for_learning", "route_memory_write_performed"],
      "properties": { "feedback_receipt_required_for_learning": { "type": "boolean" }, "route_memory_write_performed": { "const": false } }
    },
    "authority_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_capability_is_authority", "grant_issued_by_sdk", "independent_witness_required_for_success", "production_authority", "route_continuation_authority"],
      "properties": {
        "adapter_capability_is_authority": { "const": false }, "grant_issued_by_sdk": { "const": false },
        "independent_witness_required_for_success": { "const": true }, "production_authority": { "const": false }, "route_continuation_authority": { "const": false }
      }
    },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "manifest_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "manifest_digest", "adapter_id", "adapter_artifact_digest"],
      "properties": { "manifest_id": { "type": "string", "pattern": "^manifest:[a-f0-9]{64}$" }, "manifest_digest": { "$ref": "#/$defs/digest" }, "adapter_id": { "$ref": "#/$defs/id" }, "adapter_artifact_digest": { "$ref": "#/$defs/digest" } }
    },
    "proposal_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "proposal_digest"],
      "properties": { "proposal_id": { "type": "string", "pattern": "^proposal:[a-f0-9]{64}$" }, "proposal_digest": { "$ref": "#/$defs/digest" } }
    },
    "envelope_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_id", "envelope_digest"],
      "properties": { "envelope_id": { "type": "string", "pattern": "^envelope:[a-f0-9]{64}$" }, "envelope_digest": { "$ref": "#/$defs/digest" } }
    },
    "operation_binding_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "binding_digest", "conformance_receipt_id", "conformance_receipt_digest", "conformance_readiness", "operation_kind", "operation_manifest_id", "operation_manifest_digest", "executor_id", "executor_artifact_digest", "executor_key_id"],
      "properties": {
        "binding_id": { "type": "string", "pattern": "^adapter-operation-binding:[a-f0-9]{64}$" },
        "binding_digest": { "$ref": "#/$defs/digest" },
        "conformance_receipt_id": { "type": "string", "pattern": "^adapter-conformance-receipt:[a-f0-9]{64}$" },
        "conformance_receipt_digest": { "$ref": "#/$defs/digest" },
        "conformance_readiness": { "enum": ["source-ready", "target-live-ready", "portfolio-ready"] },
        "operation_kind": { "enum": ["readonly-operation-manifest", "adapter-target-operation"] },
        "operation_manifest_id": { "type": "string", "pattern": "^(?:operation-manifest|adapter-target-operation):[a-f0-9]{64}$" },
        "operation_manifest_digest": { "$ref": "#/$defs/digest" },
        "executor_id": { "$ref": "#/$defs/id" },
        "executor_artifact_digest": { "$ref": "#/$defs/digest" },
        "executor_key_id": { "$ref": "#/$defs/id" }
      }
    },
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_id", "executor_artifact_digest", "key_id"],
      "properties": {
        "executor_id": { "$ref": "#/$defs/id" },
        "executor_artifact_digest": { "$ref": "#/$defs/digest" },
        "key_id": { "$ref": "#/$defs/id" }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "request_digest", "decision_id", "decision_digest", "grant_id", "consumption_id", "consumption_digest", "ledger_event_digest", "checkpoint_digest", "consumed_at"],
      "properties": {
        "request_id": { "type": "string", "pattern": "^toolz-authorization-request:[a-f0-9]{64}$" }, "request_digest": { "$ref": "#/$defs/digest" },
        "decision_id": { "type": "string", "pattern": "^toolz-authority-decision:[a-f0-9]{64}$" }, "decision_digest": { "$ref": "#/$defs/digest" },
        "grant_id": { "type": "string", "pattern": "^toolz-single-use-grant:[a-f0-9]{64}$" }, "consumption_id": { "type": "string", "pattern": "^toolz-grant-consumption:[a-f0-9]{64}$" },
        "consumption_digest": { "$ref": "#/$defs/digest" }, "ledger_event_digest": { "$ref": "#/$defs/digest" }, "checkpoint_digest": { "$ref": "#/$defs/digest" }, "consumed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "witness": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "observation_digest", "observer_id", "observer_artifact_digest", "key_id", "key_fingerprint", "outcome", "reason_code"],
      "properties": {
        "observation_id": { "type": "string", "pattern": "^toolz-action-outcome-observation:[a-f0-9]{64}$" }, "observation_digest": { "$ref": "#/$defs/digest" },
        "observer_id": { "$ref": "#/$defs/id" }, "observer_artifact_digest": { "$ref": "#/$defs/digest" },
        "key_id": { "$ref": "#/$defs/id" }, "key_fingerprint": { "$ref": "#/$defs/digest" },
        "outcome": { "enum": ["expected-transition-observed", "pre-state-retained", "unexpected-state-observed", "outcome-unknown"] },
        "reason_code": { "enum": ["expected-transition", "pre-state-retained", "unexpected-state", "observer-unavailable", "observation-timeout", "executor-crash-reported", "transport-loss-reported"] }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": { "algorithm": { "const": "ed25519" }, "key_id": { "$ref": "#/$defs/id" }, "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" } }
    }
  }
}
