{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-target-operation.schema.json",
  "title": "Integrity ASDK typed target operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id", "protocol", "sdk_version", "tenant_id", "manifest",
    "intent_operation_digest", "target", "payload", "blast_radius",
    "required_channels", "controls", "created_at", "signer_id", "signature"
  ],
  "properties": {
    "operation_id": { "type": "string", "pattern": "^adapter-target-operation:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/adapter-target-operation/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "tenant_id": { "const": "tenant:public-6e3cdbebaafc8efa" },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "manifest_digest", "adapter_id", "adapter_artifact_digest"],
      "properties": {
        "manifest_id": { "type": "string", "pattern": "^manifest:[a-f0-9]{64}$" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "adapter_id": { "$ref": "#/$defs/id" },
        "adapter_artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "intent_operation_digest": { "$ref": "#/$defs/digest" },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "zone_id", "kind", "environment_digest", "before_state_digest", "expected_after_state_digest"],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "zone_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["workspace", "host", "browser", "network", "service", "custom"] },
        "environment_digest": { "$ref": "#/$defs/digest" },
        "before_state_digest": { "$ref": "#/$defs/digest" },
        "expected_after_state_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "schema_digest", "document_digest"],
      "properties": {
        "schema_id": { "$ref": "#/$defs/id" },
        "schema_digest": { "$ref": "#/$defs/digest" },
        "document_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "blast_radius": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_kind", "allowed_resource_ids", "allowed_resource_set_digest", "max_resources"],
      "properties": {
        "resource_kind": { "enum": ["path", "host", "service", "browser-context", "network-endpoint", "custom"] },
        "allowed_resource_ids": {
          "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "allowed_resource_set_digest": { "$ref": "#/$defs/digest" },
        "max_resources": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "required_channels": { "$ref": "#/$defs/channels" },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["max_invocations", "operation_substitution_allowed", "automatic_retry_after_unknown", "home_input", "memory_write", "production_authority"],
      "properties": {
        "max_invocations": { "const": 1 },
        "operation_substitution_allowed": { "const": false },
        "automatic_retry_after_unknown": { "const": false },
        "home_input": { "const": false },
        "memory_write": { "const": false },
        "production_authority": { "const": false }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "channels": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "browser_control", "computer_use", "credentials", "network", "service_control", "shell"],
      "properties": {
        "api": { "type": "boolean" }, "browser_control": { "type": "boolean" },
        "computer_use": { "type": "boolean" }, "credentials": { "type": "boolean" },
        "network": { "type": "boolean" }, "service_control": { "type": "boolean" },
        "shell": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
