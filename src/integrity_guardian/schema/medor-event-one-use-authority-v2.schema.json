{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v2/medor-event-one-use-authority.schema.json",
  "title": "Context-bound Medor single-use canonical Seed append authority v2",
  "type": "object", "additionalProperties": false,
  "required": [
    "receipt_id", "protocol", "grant_id", "architecture_admission_id",
    "security_admission_id", "request_digest", "route_digest",
    "context_admission_id", "logical_generation", "external_decision",
    "decision_event", "decision_checkpoint", "decision_inclusion_proof",
    "consumption_event", "consumption_checkpoint", "consumption_inclusion_proof",
    "open_status", "single_use", "max_transitions", "consumption_recorded",
    "automatic_retry_allowed", "production_authority"
  ],
  "properties": {
    "receipt_id": {"$ref": "#/$defs/digest"},
    "protocol": {"const": "integrity-guardian/medor-event-one-use-authority/v2"},
    "grant_id": {"$ref": "#/$defs/digest"},
    "architecture_admission_id": {"$ref": "#/$defs/digest"},
    "security_admission_id": {"$ref": "#/$defs/digest"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "route_digest": {"$ref": "#/$defs/digest"},
    "context_admission_id": {"$ref": "#/$defs/digest"},
    "logical_generation": {"type": "integer", "minimum": 1},
    "external_decision": {"type": "object"},
    "decision_event": {"type": "object"},
    "decision_checkpoint": {"type": "object"},
    "decision_inclusion_proof": {"type": "object"},
    "consumption_event": {"type": "object"},
    "consumption_checkpoint": {"type": "object"},
    "consumption_inclusion_proof": {"type": "object"},
    "open_status": {"enum": ["empty", "retained-head", "recovered-immediate-child"]},
    "single_use": {"const": true},
    "max_transitions": {"const": 1},
    "consumption_recorded": {"const": true},
    "automatic_retry_allowed": {"const": false},
    "production_authority": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
