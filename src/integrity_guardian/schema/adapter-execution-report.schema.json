{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-execution-report.schema.json",
  "title": "Integrity Adapter SDK Signed Execution Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id", "protocol", "sdk_version", "tenant_id", "envelope",
    "adapter", "operation_binding", "conformance", "executor", "operation", "reported_outcome", "controls",
    "recorded_at", "signer_id", "signature"
  ],
  "properties": {
    "report_id": { "type": "string", "pattern": "^report:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/adapter-execution-report/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "tenant_id": { "const": "tenant:public-6e3cdbebaafc8efa" },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_id", "envelope_digest"],
      "properties": {
        "envelope_id": { "type": "string", "pattern": "^envelope:[a-f0-9]{64}$" },
        "envelope_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "adapter_artifact_digest"],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/id" },
        "adapter_artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operation_binding": { "$ref": "#/$defs/operation_binding_ref" },
    "conformance": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "receipt_digest", "readiness"],
      "properties": {
        "receipt_id": { "type": "string", "pattern": "^adapter-conformance-receipt:[a-f0-9]{64}$" },
        "receipt_digest": { "$ref": "#/$defs/digest" },
        "readiness": { "enum": ["source-ready", "target-live-ready", "portfolio-ready"] }
      }
    },
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_id", "executor_artifact_digest", "key_id"],
      "properties": {
        "executor_id": { "$ref": "#/$defs/id" },
        "executor_artifact_digest": { "$ref": "#/$defs/digest" },
        "key_id": { "$ref": "#/$defs/id" }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["intent_operation_digest", "contract_kind", "contract_id", "contract_digest", "schema_id", "receipt_id", "receipt_digest", "evidence_artifact_count"],
      "properties": {
        "intent_operation_digest": { "$ref": "#/$defs/digest" },
        "contract_kind": { "enum": ["readonly-operation-manifest", "adapter-target-operation"] },
        "contract_id": { "type": "string", "pattern": "^(?:operation-manifest|adapter-target-operation):[a-f0-9]{64}$" },
        "contract_digest": { "$ref": "#/$defs/digest" },
        "schema_id": { "$ref": "#/$defs/id" },
        "receipt_id": { "$ref": "#/$defs/id" },
        "receipt_digest": { "$ref": "#/$defs/digest" },
        "evidence_artifact_count": { "type": "integer", "minimum": 0, "maximum": 128 }
      }
    },
    "reported_outcome": { "enum": ["reported-success", "reported-failure", "outcome-unknown"] },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["action_replay_allowed", "automatic_retry_after_unknown", "independent_witness_is_executor", "memory_write", "network", "credentials", "production_authority"],
      "properties": {
        "action_replay_allowed": { "const": false },
        "automatic_retry_after_unknown": { "const": false },
        "independent_witness_is_executor": { "const": false },
        "memory_write": { "const": false },
        "network": { "type": "boolean" },
        "credentials": { "type": "boolean" },
        "production_authority": { "const": false }
      }
    },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "operation_binding_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "binding_digest", "conformance_receipt_id", "conformance_receipt_digest", "conformance_readiness", "operation_kind", "operation_manifest_id", "operation_manifest_digest", "executor_id", "executor_artifact_digest", "executor_key_id"],
      "properties": {
        "binding_id": { "type": "string", "pattern": "^adapter-operation-binding:[a-f0-9]{64}$" },
        "binding_digest": { "$ref": "#/$defs/digest" },
        "conformance_receipt_id": { "type": "string", "pattern": "^adapter-conformance-receipt:[a-f0-9]{64}$" },
        "conformance_receipt_digest": { "$ref": "#/$defs/digest" },
        "conformance_readiness": { "enum": ["source-ready", "target-live-ready", "portfolio-ready"] },
        "operation_kind": { "enum": ["readonly-operation-manifest", "adapter-target-operation"] },
        "operation_manifest_id": { "type": "string", "pattern": "^(?:operation-manifest|adapter-target-operation):[a-f0-9]{64}$" },
        "operation_manifest_digest": { "$ref": "#/$defs/digest" },
        "executor_id": { "$ref": "#/$defs/id" },
        "executor_artifact_digest": { "$ref": "#/$defs/digest" },
        "executor_key_id": { "$ref": "#/$defs/id" }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
