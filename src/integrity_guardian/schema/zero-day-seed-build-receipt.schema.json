{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/zero-day-seed-build-receipt.schema.json",
  "title": "Zero-day Seed build receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "receipt_id",
    "status",
    "profile_id",
    "source_namespace",
    "evidence_bindings",
    "event_count",
    "minimum_event_id",
    "maximum_event_id",
    "source_digest",
    "catalog_digest",
    "home_record_count",
    "imports_remote_memory",
    "production_authority"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/zero-day-seed-build-receipt/v1" },
    "receipt_id": { "type": "string", "pattern": "^zero-day-seed:[a-f0-9]{64}$" },
    "status": { "enum": ["PASS", "FAIL"] },
    "profile_id": { "type": "string", "pattern": "^local-profile:[a-f0-9]{64}$" },
    "source_namespace": { "type": "string", "pattern": "^seed://project/[a-z0-9][a-z0-9._-]{0,127}$" },
    "evidence_bindings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 72,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "digest", "event_ids"],
        "properties": {
          "kind": {
            "enum": [
              "local-machine-profile",
              "collector-result",
              "readonly-operation-manifest",
              "readonly-operation-receipt"
            ]
          },
          "digest": { "$ref": "#/$defs/digest" },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2048,
            "items": { "type": "integer", "minimum": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "event_count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "minimum_event_id": { "const": 1 },
    "maximum_event_id": { "type": "integer", "minimum": 1 },
    "source_digest": { "$ref": "#/$defs/digest" },
    "catalog_digest": { "$ref": "#/$defs/digest" },
    "home_record_count": { "const": 0 },
    "imports_remote_memory": { "const": false },
    "production_authority": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
