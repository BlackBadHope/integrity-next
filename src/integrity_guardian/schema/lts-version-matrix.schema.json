{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v2/lts-version-matrix.schema.json",
  "title": "Integrity LTS version matrix v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "umbrella",
    "product",
    "components",
    "integrations",
    "compatibility",
    "installation",
    "production_authority",
    "memory_grants_authority"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/lts-version-matrix/v2"
    },
    "umbrella": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "release_id",
        "tag",
        "status"
      ],
      "properties": {
        "name": {
          "const": "Integrity LTS"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "release_id": {
          "type": "string",
          "pattern": "^release:lts:integrity:[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.]+)?$"
        },
        "tag": {
          "type": "string",
          "pattern": "^lts/integrity/v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.]+)?$"
        },
        "status": {
          "enum": [
            "candidate",
            "active"
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "lifecycle"
      ],
      "properties": {
        "name": {
          "const": "Integrity Guardian"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "lifecycle": {
          "enum": [
            "stable",
            "prerelease"
          ]
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/integration"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versioning",
        "selection",
        "signed_release_index_required",
        "product_prerelease_blocks_umbrella_activation",
        "component_prerelease_blocks_umbrella_activation",
        "schema_breaks_require_new_major"
      ],
      "properties": {
        "versioning": {
          "const": "independent-component-semver"
        },
        "selection": {
          "const": "exact-version-bom"
        },
        "signed_release_index_required": {
          "const": true
        },
        "product_prerelease_blocks_umbrella_activation": {
          "const": true
        },
        "component_prerelease_blocks_umbrella_activation": {
          "const": true
        },
        "schema_breaks_require_new_major": {
          "const": true
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "windows",
        "posix",
        "automatic_remote_rollout"
      ],
      "properties": {
        "artifact_class": {
          "const": "signed-offline-bundle"
        },
        "windows": {
          "const": "native-offline-bundle"
        },
        "posix": {
          "const": "verified-offline-wheelhouse"
        },
        "automatic_remote_rollout": {
          "const": false
        }
      }
    },
    "production_authority": {
      "const": false
    },
    "memory_grants_authority": {
      "const": false
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:(?:a|b|rc)[0-9]+|-[A-Za-z0-9]+(?:\\.[A-Za-z0-9]+)*)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "url",
        "manifest_digest",
        "bundle_digest"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "bundle_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "name",
        "version",
        "lifecycle",
        "status",
        "source_revision"
      ],
      "properties": {
        "track_id": {
          "enum": [
            "guardian-core-lts",
            "seed-synapse-lts",
            "adapter-observer-sdk-lts"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "lifecycle": {
          "enum": [
            "stable",
            "prerelease"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "active"
          ]
        },
        "source_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "release": {
          "$ref": "#/$defs/release"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "candidate"
              }
            },
            "required": [
              "status"
            ]
          },
          "else": {
            "properties": {
              "source_revision": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        }
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_id",
        "name",
        "version",
        "lifecycle",
        "status",
        "source_revision"
      ],
      "properties": {
        "integration_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "lifecycle": {
          "enum": [
            "stable",
            "prerelease"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "included"
          ]
        },
        "source_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "candidate"
              }
            },
            "required": [
              "status"
            ]
          },
          "else": {
            "properties": {
              "source_revision": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        }
      ]
    }
  }
}
