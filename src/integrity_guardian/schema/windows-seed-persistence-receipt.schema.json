{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/windows-seed-persistence-receipt.schema.json",
  "title": "Windows Seed persistence receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "task_name",
    "task_path",
    "mode",
    "user_id",
    "logon_type",
    "run_level",
    "trigger",
    "trigger_user_id",
    "multiple_instances",
    "start_when_available",
    "hidden",
    "console_application",
    "action_digest",
    "listener",
    "installed_at",
    "install_boot_time",
    "source_digest",
    "catalog_digest",
    "event_count",
    "credential_in_arguments",
    "production_authority"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/windows-seed-persistence-receipt/v1" },
    "status": { "const": "PASS" },
    "task_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "task_path": { "const": "\\" },
    "mode": { "enum": ["CurrentUser", "System"] },
    "user_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "logon_type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "run_level": { "type": "string", "minLength": 1, "maxLength": 128 },
    "trigger": { "const": "AtLogOn" },
    "trigger_user_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "multiple_instances": { "const": "IgnoreNew" },
    "start_when_available": { "const": true },
    "hidden": { "const": true },
    "console_application": { "const": false },
    "action_digest": { "$ref": "#/$defs/digest" },
    "listener": { "type": "string", "pattern": "^127[.]0[.]0[.]1:[1-9][0-9]{0,4}$" },
    "installed_at": { "type": "string", "format": "date-time" },
    "install_boot_time": { "type": "string", "format": "date-time" },
    "source_digest": { "$ref": "#/$defs/digest" },
    "catalog_digest": { "$ref": "#/$defs/digest" },
    "event_count": { "type": "integer", "minimum": 1 },
    "credential_in_arguments": { "const": false },
    "production_authority": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
