{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v2/adapter-deployment-cohort-receipt-v2.schema.json",
  "title": "Integrity ASDK three-host deployment cohort receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "protocol",
    "sdk_version",
    "deployment",
    "manifest",
    "package",
    "guardian",
    "evidence",
    "result",
    "authority_boundary",
    "created_at",
    "signer_id",
    "signature"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^adapter-deployment-cohort-receipt-v2:[a-f0-9]{64}$"
    },
    "protocol": {
      "const": "integrity-guardian/adapter-deployment-cohort-receipt/v2"
    },
    "sdk_version": {
      "const": "1.0.0a2"
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "guardian": {
      "$ref": "#/$defs/guardian"
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host_role",
          "platform_family",
          "evidence_id",
          "evidence_digest",
          "host_identity_digest",
          "environment_identity_digest",
          "precondition_receipt_digests",
          "phase_receipt_digests",
          "assessor_signer_id"
        ],
        "properties": {
          "host_role": {
            "enum": [
              "linux-primary",
              "windows-vm",
              "client-workstation"
            ]
          },
          "platform_family": {
            "enum": [
              "linux",
              "windows"
            ]
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^adapter-deployment-host-lifecycle-evidence-v2:[a-f0-9]{64}$"
          },
          "evidence_digest": {
            "$ref": "#/$defs/digest"
          },
          "host_identity_digest": {
            "$ref": "#/$defs/digest"
          },
          "environment_identity_digest": {
            "$ref": "#/$defs/digest"
          },
          "phase_receipt_digests": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "install",
              "upgrade",
              "revoke",
              "recovery"
            ],
            "properties": {
              "install": {
                "$ref": "#/$defs/digest"
              },
              "upgrade": {
                "$ref": "#/$defs/digest"
              },
              "revoke": {
                "$ref": "#/$defs/digest"
              },
              "recovery": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "assessor_signer_id": {
            "$ref": "#/$defs/id"
          },
          "precondition_receipt_digests": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "install",
              "upgrade",
              "revoke",
              "recovery"
            ],
            "properties": {
              "install": {
                "$ref": "#/$defs/digest"
              },
              "upgrade": {
                "$ref": "#/$defs/digest"
              },
              "revoke": {
                "$ref": "#/$defs/digest"
              },
              "recovery": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_roles",
        "lifecycle_complete",
        "exact_package_shared",
        "exact_guardian_shared",
        "typed_preconditions_verified",
        "typed_phase_receipts_verified",
        "no_receipt_reuse_in_consumed_evidence",
        "independent_assessors",
        "readiness"
      ],
      "properties": {
        "host_roles": {
          "type": "array",
          "prefixItems": [
            {
              "const": "linux-primary"
            },
            {
              "const": "windows-vm"
            },
            {
              "const": "client-workstation"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "lifecycle_complete": {
          "const": true
        },
        "exact_package_shared": {
          "const": true
        },
        "exact_guardian_shared": {
          "const": true
        },
        "typed_phase_receipts_verified": {
          "const": true
        },
        "no_receipt_reuse_in_consumed_evidence": {
          "const": true
        },
        "independent_assessors": {
          "const": true
        },
        "readiness": {
          "const": "deployment-cohort-ready"
        },
        "typed_preconditions_verified": {
          "const": true
        }
      }
    },
    "authority_boundary": {
      "$ref": "#/$defs/authority"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "signer_id": {
      "$ref": "#/$defs/id"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_run_id",
        "challenge_digest"
      ],
      "properties": {
        "deployment_run_id": {
          "type": "string",
          "pattern": "^adapter-deployment-run:[a-f0-9]{64}$"
        },
        "challenge_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_digest",
        "adapter_id",
        "adapter_artifact_digest"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "pattern": "^manifest:[a-f0-9]{64}$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "adapter_id": {
          "$ref": "#/$defs/id"
        },
        "adapter_artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "artifact_digest"
      ],
      "properties": {
        "distribution": {
          "const": "integrity-adapter-sdk"
        },
        "version": {
          "const": "1.0.0"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "guardian": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "artifact_digest"
      ],
      "properties": {
        "distribution": {
          "const": "integrity-guardian"
        },
        "version": {
          "const": "6.0.0"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues_grants",
        "executes_actions",
        "memory_write",
        "production_authority"
      ],
      "properties": {
        "issues_grants": {
          "const": false
        },
        "executes_actions": {
          "const": false
        },
        "memory_write": {
          "const": false
        },
        "production_authority": {
          "const": false
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,128}$"
        }
      }
    }
  }
}
