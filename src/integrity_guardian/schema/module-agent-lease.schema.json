{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/module-agent-lease.schema.json",
  "title": "Integrity Module Agent Lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "lease_id",
    "tenant_id",
    "module_id",
    "agent_id",
    "agent_key_id",
    "generation",
    "sequence",
    "event_cursor",
    "state_digest",
    "valid_from",
    "valid_until",
    "status",
    "authority_id",
    "production_authority",
    "signature"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/module-agent-lease/v1" },
    "lease_id": {
      "type": "string",
      "pattern": "^lease:[a-f0-9]{64}$"
    },
    "tenant_id": { "$ref": "#/$defs/tenant_id" },
    "module_id": { "$ref": "#/$defs/id" },
    "agent_id": { "$ref": "#/$defs/id" },
    "agent_key_id": { "$ref": "#/$defs/id" },
    "generation": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "event_cursor": { "type": "integer", "minimum": 0 },
    "state_digest": { "$ref": "#/$defs/digest" },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "valid_until": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["active", "released"] },
    "authority_id": { "$ref": "#/$defs/id" },
    "production_authority": { "const": false },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant:[A-Za-z0-9][A-Za-z0-9._:/-]{0,248}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
