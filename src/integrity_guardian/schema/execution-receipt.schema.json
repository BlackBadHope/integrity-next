{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/execution-receipt.schema.json",
  "title": "Guardian External Executor Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "receipt_id",
    "envelope_digest",
    "response_id",
    "tenant_id",
    "target_id",
    "executor_id",
    "status",
    "preflight_evidence_digest",
    "action_evidence_digest",
    "compensation_evidence_digest",
    "postcheck_evidence_digest",
    "recorded_at",
    "signer_id",
    "signature"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/execution-receipt/v1" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "envelope_digest": { "$ref": "#/$defs/digest" },
    "response_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "target_id": { "$ref": "#/$defs/id" },
    "executor_id": { "$ref": "#/$defs/id" },
    "status": {
      "enum": [
        "preflight-denied",
        "apply-failed-no-change",
        "applied-postcheck-pass",
        "applied-postcheck-fail-compensated",
        "compensation-failed"
      ]
    },
    "preflight_evidence_digest": { "$ref": "#/$defs/digest" },
    "action_evidence_digest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "compensation_evidence_digest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "postcheck_evidence_digest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
