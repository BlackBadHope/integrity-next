{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/task-closure-receipt.schema.json",
  "title": "Integrity task closure receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "closure_id",
    "task_id",
    "status",
    "phase_id",
    "completed_at",
    "evidence_digest",
    "instruction_state",
    "terminal_event",
    "mutation_boundary",
    "authority_boundary"
  ],
  "properties": {
    "protocol": {"const": "integrity-guardian/task-closure-receipt/v1"},
    "closure_id": {"type": "string", "pattern": "^task-closure:[a-f0-9]{64}$"},
    "task_id": {"$ref": "#/$defs/id"},
    "status": {"const": "complete"},
    "phase_id": {"const": "closure"},
    "completed_at": {"type": "string", "format": "date-time"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "instruction_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction_head_digest",
        "instruction_head_sequence",
        "instruction_chain_digest",
        "task_terminal_event_append",
        "phase_terminal_event_append",
        "effective_terminal_event_append",
        "expired_phase_ids"
      ],
      "properties": {
        "instruction_head_digest": {"$ref": "#/$defs/digest"},
        "instruction_head_sequence": {"type": "integer", "minimum": 1},
        "instruction_chain_digest": {"$ref": "#/$defs/digest"},
        "task_terminal_event_append": {"enum": ["allow", "deny"]},
        "phase_terminal_event_append": {"enum": ["allow", "deny", "inherit"]},
        "effective_terminal_event_append": {"const": "allow"},
        "expired_phase_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "terminal_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_uid",
        "event_id",
        "append_state",
        "request_sha256",
        "append_attempt_id"
      ],
      "properties": {
        "event_uid": {"type": "string", "pattern": "^client:task-closure:[a-f0-9]{64}$"},
        "event_id": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "append_state": {
          "enum": ["confirmed-created", "confirmed-duplicate", "reconciled-created"]
        },
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "append_attempt_id": {"type": "string", "pattern": "^action-log-append-attempt:[a-f0-9]{64}$"}
      }
    },
    "mutation_boundary": {"$ref": "#/$defs/mutation_boundary"},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "network", "production_authority", "route_authority"],
      "properties": {
        "execution": {"const": false},
        "network": {"const": false},
        "production_authority": {"const": false},
        "route_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "mutation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["update", "delete", "import", "overwrite", "bulk_write"],
      "properties": {
        "update": {"const": false},
        "delete": {"const": false},
        "import": {"const": false},
        "overwrite": {"const": false},
        "bulk_write": {"const": false}
      }
    }
  }
}
