{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-platform-lifecycle-evidence.schema.json",
  "title": "Integrity ASDK platform lifecycle evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "protocol", "sdk_version", "manifest", "platform", "receipt_model_digest", "lifecycle", "actual_host", "synthetic", "content_free", "authority_boundary", "created_at", "signer_id", "signature"],
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^adapter-platform-lifecycle-evidence:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/adapter-platform-lifecycle-evidence/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "architecture", "environment_digest", "runtime_digest", "runner_digest"],
      "properties": {
        "family": { "enum": ["linux", "windows", "macos"] },
        "architecture": { "$ref": "#/$defs/id" },
        "environment_digest": { "$ref": "#/$defs/digest" },
        "runtime_digest": { "$ref": "#/$defs/digest" },
        "runner_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "receipt_model_digest": { "$ref": "#/$defs/digest" },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean_install_receipt_digest", "upgrade_receipt_digest", "revoke_receipt_digest", "recovery_receipt_digest"],
      "properties": {
        "clean_install_receipt_digest": { "$ref": "#/$defs/digest" },
        "upgrade_receipt_digest": { "$ref": "#/$defs/digest" },
        "revoke_receipt_digest": { "$ref": "#/$defs/digest" },
        "recovery_receipt_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "actual_host": { "const": true },
    "synthetic": { "const": false },
    "content_free": { "const": true },
    "authority_boundary": { "$ref": "#/$defs/authority" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "manifest_digest", "adapter_id", "adapter_artifact_digest"],
      "properties": {
        "manifest_id": { "type": "string", "pattern": "^manifest:[a-f0-9]{64}$" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "adapter_id": { "$ref": "#/$defs/id" },
        "adapter_artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues_grants", "executes_actions", "memory_write", "production_authority"],
      "properties": {
        "issues_grants": { "const": false },
        "executes_actions": { "const": false },
        "memory_write": { "const": false },
        "production_authority": { "const": false }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
