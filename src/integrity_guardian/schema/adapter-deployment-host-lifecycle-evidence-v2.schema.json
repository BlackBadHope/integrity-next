{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v2/adapter-deployment-host-lifecycle-evidence-v2.schema.json",
  "title": "Integrity ASDK deployment host lifecycle evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "protocol",
    "sdk_version",
    "deployment",
    "manifest",
    "package",
    "guardian",
    "host",
    "lifecycle",
    "actual_host",
    "synthetic",
    "content_free",
    "independence",
    "authority_boundary",
    "created_at",
    "signer_id",
    "signature"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^adapter-deployment-host-lifecycle-evidence-v2:[a-f0-9]{64}$"
    },
    "protocol": {
      "const": "integrity-guardian/adapter-deployment-host-lifecycle-evidence/v2"
    },
    "sdk_version": {
      "const": "1.0.0a2"
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "guardian": {
      "$ref": "#/$defs/guardian"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "platform_family",
        "architecture",
        "host_identity_digest",
        "platform_identity_digest",
        "environment_identity_digest"
      ],
      "properties": {
        "role": {
          "enum": [
            "linux-primary",
            "windows-vm",
            "client-workstation"
          ]
        },
        "platform_family": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "architecture": {
          "$ref": "#/$defs/id"
        },
        "host_identity_digest": {
          "$ref": "#/$defs/digest"
        },
        "platform_identity_digest": {
          "$ref": "#/$defs/digest"
        },
        "environment_identity_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "upgrade",
        "revoke",
        "recovery"
      ],
      "properties": {
        "install": {
          "$ref": "#/$defs/phase_reference"
        },
        "upgrade": {
          "$ref": "#/$defs/phase_reference"
        },
        "revoke": {
          "$ref": "#/$defs/phase_reference"
        },
        "recovery": {
          "$ref": "#/$defs/phase_reference"
        }
      }
    },
    "actual_host": {
      "const": true
    },
    "synthetic": {
      "const": false
    },
    "content_free": {
      "const": true
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_signer_id",
        "precondition_observer_signer_ids",
        "executor_signer_ids",
        "observer_signer_ids",
        "phase_assessor_signer_ids",
        "assessor_signer_id",
        "same_identity",
        "assessor_distinct_from_all_consumed"
      ],
      "properties": {
        "subject_signer_id": {
          "$ref": "#/$defs/id"
        },
        "executor_signer_ids": {
          "$ref": "#/$defs/signer_ids"
        },
        "observer_signer_ids": {
          "$ref": "#/$defs/signer_ids"
        },
        "phase_assessor_signer_ids": {
          "$ref": "#/$defs/signer_ids"
        },
        "assessor_signer_id": {
          "$ref": "#/$defs/id"
        },
        "same_identity": {
          "const": false
        },
        "assessor_distinct_from_all_consumed": {
          "const": true
        },
        "precondition_observer_signer_ids": {
          "$ref": "#/$defs/signer_ids"
        }
      }
    },
    "authority_boundary": {
      "$ref": "#/$defs/authority"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "signer_id": {
      "$ref": "#/$defs/id"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_run_id",
        "challenge_digest"
      ],
      "properties": {
        "deployment_run_id": {
          "type": "string",
          "pattern": "^adapter-deployment-run:[a-f0-9]{64}$"
        },
        "challenge_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "signer_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_digest",
        "adapter_id",
        "adapter_artifact_digest"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "pattern": "^manifest:[a-f0-9]{64}$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "adapter_id": {
          "$ref": "#/$defs/id"
        },
        "adapter_artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "artifact_digest"
      ],
      "properties": {
        "distribution": {
          "const": "integrity-adapter-sdk"
        },
        "version": {
          "const": "1.0.0"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "guardian": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "artifact_digest"
      ],
      "properties": {
        "distribution": {
          "const": "integrity-guardian"
        },
        "version": {
          "const": "6.0.0"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "phase_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "phase_receipt_id",
        "phase_receipt_digest",
        "attempt_id",
        "precondition_receipt_id",
        "precondition_receipt_digest",
        "execution_receipt_id",
        "execution_receipt_digest",
        "postcondition_receipt_id",
        "postcondition_receipt_digest",
        "precondition_observer_signer_id",
        "executor_signer_id",
        "observer_signer_id",
        "phase_assessor_signer_id"
      ],
      "properties": {
        "result": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "phase_receipt_id": {
          "type": "string",
          "pattern": "^adapter-deployment-lifecycle-phase-receipt:[a-f0-9]{64}$"
        },
        "phase_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^adapter-deployment-lifecycle-attempt:[a-f0-9]{64}$"
        },
        "execution_receipt_id": {
          "type": "string",
          "pattern": "^adapter-deployment-lifecycle-execution-receipt:[a-f0-9]{64}$"
        },
        "execution_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "postcondition_receipt_id": {
          "type": "string",
          "pattern": "^adapter-deployment-lifecycle-postcondition-receipt:[a-f0-9]{64}$"
        },
        "postcondition_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "executor_signer_id": {
          "$ref": "#/$defs/id"
        },
        "observer_signer_id": {
          "$ref": "#/$defs/id"
        },
        "phase_assessor_signer_id": {
          "$ref": "#/$defs/id"
        },
        "precondition_receipt_id": {
          "type": "string",
          "pattern": "^adapter-deployment-lifecycle-precondition-receipt:[a-f0-9]{64}$"
        },
        "precondition_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "precondition_observer_signer_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues_grants",
        "executes_actions",
        "memory_write",
        "production_authority"
      ],
      "properties": {
        "issues_grants": {
          "const": false
        },
        "executes_actions": {
          "const": false
        },
        "memory_write": {
          "const": false
        },
        "production_authority": {
          "const": false
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,128}$"
        }
      }
    }
  }
}
