{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/execution-containment-receipt.schema.json",
  "title": "Integrity Execution Containment Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "receipt_id",
    "tenant_id",
    "subject",
    "policy_digest",
    "environment",
    "harness",
    "assurance_class",
    "readiness",
    "controls",
    "monitor",
    "allowed_channels",
    "exceptions",
    "created_at",
    "expires_at",
    "authority_boundary",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/execution-containment-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^execution-containment-receipt:[a-f0-9]{64}$"
    },
    "tenant_id": { "const": "tenant:public-6e3cdbebaafc8efa" },
    "subject": { "$ref": "#/$defs/subject" },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "environment": {
      "allOf": [
        { "$ref": "#/$defs/environment" },
        {
          "type": "object",
          "required": ["supported"]
        }
      ]
    },
    "harness": { "$ref": "#/$defs/harness" },
    "assurance_class": {
      "enum": ["protected", "audit", "degraded", "failed", "unsupported"]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready_before_untrusted_work", "policy_frozen"],
      "properties": {
        "ready_before_untrusted_work": { "type": "boolean" },
        "policy_frozen": { "type": "boolean" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "egress",
        "privilege",
        "container_control",
        "secrets"
      ],
      "properties": {
        "egress": {
          "enum": ["blocked", "bounded", "observed", "unrestricted"]
        },
        "privilege": {
          "enum": ["removed", "bounded", "observed", "unrestricted"]
        },
        "container_control": {
          "enum": ["disabled", "bounded", "observed", "available"]
        },
        "secrets": {
          "enum": ["absent", "bounded", "observed", "unrestricted"]
        }
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resident", "continuous", "post_run_drift"],
      "properties": {
        "resident": { "type": "boolean" },
        "continuous": { "type": "boolean" },
        "post_run_drift": { "enum": ["none", "detected", "unknown"] }
      }
    },
    "allowed_channels": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "authority_boundary": { "$ref": "#/$defs/authority_boundary" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "synthetic_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}synthetic[A-Za-z0-9._:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/synthetic_id" },
        "artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "fingerprint_digest", "supported"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/synthetic_id" },
        "fingerprint_digest": { "$ref": "#/$defs/digest" },
        "supported": { "type": "boolean" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_id", "revision", "artifact_digest"],
      "properties": {
        "harness_id": { "$ref": "#/$defs/synthetic_id" },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_authority",
        "promotion_authority",
        "production_authority",
        "remediation_authority",
        "semantic_channel_authority"
      ],
      "properties": {
        "execution_authority": { "const": false },
        "promotion_authority": { "const": false },
        "production_authority": { "const": false },
        "remediation_authority": { "const": false },
        "semantic_channel_authority": { "const": false }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": {
          "type": "string",
          "pattern": "^key:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
