{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/synapse-route.schema.json",
  "title": "Integrity Synapse Route v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "route_id",
    "graph_id",
    "tenant_id",
    "context_digest",
    "start_node_id",
    "target_node_id",
    "edge_ids",
    "node_ids",
    "score",
    "verifier_ids",
    "rollback_edge_ids",
    "control_plane_calls",
    "execution_authority"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/synapse-route/v1" },
    "route_id": { "$ref": "#/$defs/digest" },
    "graph_id": { "$ref": "#/$defs/digest" },
    "tenant_id": { "$ref": "#/$defs/tenant_id" },
    "context_digest": { "$ref": "#/$defs/digest" },
    "start_node_id": { "$ref": "#/$defs/node_id" },
    "target_node_id": { "$ref": "#/$defs/node_id" },
    "edge_ids": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/edge_id" }
    },
    "node_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 33,
      "items": { "$ref": "#/$defs/node_id" }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_rank",
        "blast_radius_rank",
        "reversibility_penalty",
        "authority_count",
        "estimated_model_calls",
        "estimated_tool_calls",
        "estimated_latency_ms",
        "resource_units",
        "context_bytes",
        "hop_count"
      ],
      "properties": {
        "transition_rank": { "type": "integer", "minimum": 0, "maximum": 2 },
        "blast_radius_rank": { "type": "integer", "minimum": 0, "maximum": 4 },
        "reversibility_penalty": { "type": "integer", "minimum": 0 },
        "authority_count": { "type": "integer", "minimum": 0 },
        "estimated_model_calls": { "type": "integer", "minimum": 0 },
        "estimated_tool_calls": { "type": "integer", "minimum": 0 },
        "estimated_latency_ms": { "type": "integer", "minimum": 0 },
        "resource_units": { "type": "integer", "minimum": 0 },
        "context_bytes": { "type": "integer", "minimum": 0 },
        "hop_count": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "verifier_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" }
    },
    "rollback_edge_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge_id" }
    },
    "control_plane_calls": { "$ref": "#/$defs/control_plane_calls" },
    "execution_authority": { "const": false }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant:[A-Za-z0-9][A-Za-z0-9._:/-]{0,248}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^synapse-node:[a-f0-9]{64}$"
    },
    "edge_id": {
      "type": "string",
      "pattern": "^synapse-edge:[a-f0-9]{64}$"
    },
    "control_plane_calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_calls", "tool_calls"],
      "properties": {
        "model_calls": { "const": 0 },
        "tool_calls": { "const": 0 }
      }
    }
  }
}
