{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/native-session-lease.schema.json",
  "title": "Integrity native session lease",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "instance_id", "session_id", "device_id", "scopes", "issued_at", "expires_at", "lease_id", "signature"],
  "properties": {
    "protocol": { "const": "integrity-guardian/native-session-lease/v1" },
    "instance_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "session_id": { "type": "string", "pattern": "^session:[a-f0-9]{64}$" },
    "device_id": { "type": "string", "pattern": "^device:[A-Za-z0-9._:-]+$" },
    "scopes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" } },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "lease_id": { "$ref": "#/$defs/digest" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
