{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/memory-link-navigation.schema.json",
  "title": "Bounded canonical memory-link navigation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "graph_digest", "source_namespace", "result", "anchor",
    "candidate_count", "candidates", "trail", "visited_digest", "direction",
    "relations", "links", "link_counts", "pagination", "max_context_bytes",
    "production_authority", "route_authority", "receipt_id"
  ],
  "properties": {
    "protocol": {"const": "integrity-guardian/memory-link-navigation/v1"},
    "graph_digest": {"$ref": "#/$defs/digest"},
    "source_namespace": {"type": "string", "pattern": "^seed://project/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "result": {"enum": ["CONNECTED", "ISOLATED", "AMBIGUOUS", "NOT_FOUND"]},
    "anchor": {"oneOf": [{"$ref": "#/$defs/node"}, {"type": "null"}]},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/node"}},
    "trail": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^integrity://seed/project/"}},
    "visited_digest": {"$ref": "#/$defs/digest"},
    "direction": {"enum": ["outbound", "inbound", "both"]},
    "relations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relation"}},
    "links": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/link"}},
    "link_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible", "returned", "omitted"],
      "properties": {
        "eligible": {"type": "integer", "minimum": 0},
        "returned": {"type": "integer", "minimum": 0, "maximum": 200},
        "omitted": {"type": "integer", "minimum": 0}
      }
    },
    "pagination": {
      "type": "object", "additionalProperties": false,
      "required": ["has_more", "next_cursor", "truncated_by"],
      "properties": {
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": "string", "maxLength": 4096},
        "truncated_by": {"enum": ["none", "limit", "context-bytes"]}
      }
    },
    "max_context_bytes": {"type": "integer", "minimum": 8192, "maximum": 262144},
    "production_authority": {"const": false},
    "route_authority": {"const": false},
    "receipt_id": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "relation": {"enum": ["blocks", "child-of", "cites", "concerns", "contradicts", "defines", "depends-on", "derived-from", "located-at", "preempts", "records-task", "refers-to", "related-to", "supports", "supersedes", "tagged-with"]},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "kind", "key", "title", "aliases", "alias_count", "omitted_alias_count", "source_event_ids", "source_event_count", "omitted_source_event_count"],
      "properties": {
        "uri": {"type": "string", "pattern": "^integrity://seed/project/"},
        "kind": {"enum": ["artifact", "component", "concept", "decision", "event", "evidence", "location", "release", "subsystem", "system", "task", "term"]},
        "key": {"type": "string", "minLength": 1, "maxLength": 512},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "aliases": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "alias_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "omitted_alias_count": {"type": "integer", "minimum": 0},
        "source_event_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "source_event_count": {"type": "integer", "minimum": 1},
        "omitted_source_event_count": {"type": "integer", "minimum": 0}
      }
    },
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["source_uri", "relation", "target_uri", "provenance", "source_event_ids", "source_event_count", "omitted_source_event_count", "direction", "neighbor", "cycle", "follow_allowed"],
      "properties": {
        "source_uri": {"type": "string", "pattern": "^integrity://seed/project/"},
        "relation": {"$ref": "#/$defs/relation"},
        "target_uri": {"type": "string", "pattern": "^integrity://seed/project/"},
        "provenance": {"enum": ["structured-seed", "explicit-memory-node", "explicit-memory-link"]},
        "source_event_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "source_event_count": {"type": "integer", "minimum": 1},
        "omitted_source_event_count": {"type": "integer", "minimum": 0},
        "direction": {"enum": ["outbound", "inbound"]},
        "neighbor": {"$ref": "#/$defs/node"},
        "cycle": {"type": "boolean"},
        "follow_allowed": {"type": "boolean"}
      }
    }
  }
}
