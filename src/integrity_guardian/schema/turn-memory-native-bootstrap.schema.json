{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://integrity.guardian.invalid/schema/v1/turn-memory-native-bootstrap.schema.json",
  "type":"object","additionalProperties":false,
  "required":["protocol","namespace_fingerprint","native_path","phase","created_at","production_authority","receipt_id","signature"],
  "properties":{
    "protocol":{"const":"integrity-guardian/turn-memory-native-bootstrap/v1"},
    "namespace_fingerprint":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "native_path":{"type":"string","minLength":1},
    "phase":{"enum":["reserved","complete"]},
    "created_at":{"type":"string","format":"date-time"},
    "production_authority":{"const":false},
    "receipt_id":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "signature":{"type":"object","additionalProperties":false,
      "required":["algorithm","key_id","value"],
      "properties":{"algorithm":{"const":"ed25519"},"key_id":{"type":"string","minLength":1},"value":{"type":"string","minLength":1}}}
  }
}
