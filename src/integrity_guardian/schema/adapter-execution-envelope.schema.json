{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-execution-envelope.schema.json",
  "title": "Integrity Adapter SDK Execution Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_id", "protocol", "sdk_version", "tenant_id", "manifest", "proposal", "operation_binding", "authorization", "intent", "expected_transition", "controls", "created_at", "signer_id", "signature"],
  "properties": {
    "envelope_id": { "type": "string", "pattern": "^envelope:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/adapter-execution-envelope/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "tenant_id": { "const": "tenant:public-6e3cdbebaafc8efa" },
    "manifest": { "$ref": "#/$defs/manifest_ref" },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "proposal_digest"],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^proposal:[a-f0-9]{64}$" },
        "proposal_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operation_binding": { "$ref": "#/$defs/operation_binding_ref" },
    "authorization": { "$ref": "#/$defs/authorization" },
    "intent": { "$ref": "#/$defs/intent" },
    "expected_transition": { "$ref": "#/$defs/expected_transition" },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["max_invocations", "action_replay_allowed", "route_continuation_allowed", "automatic_retry_after_unknown", "memory_write", "production_authority"],
      "properties": {
        "max_invocations": { "const": 1 }, "action_replay_allowed": { "const": false },
        "route_continuation_allowed": { "const": false }, "automatic_retry_after_unknown": { "const": false },
        "memory_write": { "const": false }, "production_authority": { "const": false }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "action_class": { "enum": ["observe", "navigate", "activate", "input", "submit", "wait", "external-call"] },
    "manifest_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "manifest_digest", "adapter_id", "adapter_artifact_digest"],
      "properties": {
        "manifest_id": { "type": "string", "pattern": "^manifest:[a-f0-9]{64}$" }, "manifest_digest": { "$ref": "#/$defs/digest" },
        "adapter_id": { "$ref": "#/$defs/id" }, "adapter_artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operation_binding_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "binding_digest", "conformance_receipt_id", "conformance_receipt_digest", "conformance_readiness", "operation_kind", "operation_manifest_id", "operation_manifest_digest", "executor_id", "executor_artifact_digest", "executor_key_id"],
      "properties": {
        "binding_id": { "type": "string", "pattern": "^adapter-operation-binding:[a-f0-9]{64}$" },
        "binding_digest": { "$ref": "#/$defs/digest" },
        "conformance_receipt_id": { "type": "string", "pattern": "^adapter-conformance-receipt:[a-f0-9]{64}$" },
        "conformance_receipt_digest": { "$ref": "#/$defs/digest" },
        "conformance_readiness": { "enum": ["source-ready", "target-live-ready", "portfolio-ready"] },
        "operation_kind": { "enum": ["readonly-operation-manifest", "adapter-target-operation"] },
        "operation_manifest_id": { "type": "string", "pattern": "^(?:operation-manifest|adapter-target-operation):[a-f0-9]{64}$" },
        "operation_manifest_digest": { "$ref": "#/$defs/digest" },
        "executor_id": { "$ref": "#/$defs/id" },
        "executor_artifact_digest": { "$ref": "#/$defs/digest" },
        "executor_key_id": { "$ref": "#/$defs/id" }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "request_digest", "decision_id", "decision_digest", "grant_id", "consumption_id", "consumption_digest", "ledger_event_digest", "checkpoint_digest", "consumed_at"],
      "properties": {
        "request_id": { "type": "string", "pattern": "^toolz-authorization-request:[a-f0-9]{64}$" }, "request_digest": { "$ref": "#/$defs/digest" },
        "decision_id": { "type": "string", "pattern": "^toolz-authority-decision:[a-f0-9]{64}$" }, "decision_digest": { "$ref": "#/$defs/digest" },
        "grant_id": { "type": "string", "pattern": "^toolz-single-use-grant:[a-f0-9]{64}$" },
        "consumption_id": { "type": "string", "pattern": "^toolz-grant-consumption:[a-f0-9]{64}$" }, "consumption_digest": { "$ref": "#/$defs/digest" },
        "ledger_event_digest": { "$ref": "#/$defs/digest" }, "checkpoint_digest": { "$ref": "#/$defs/digest" }, "consumed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["route_proposal_id", "route_digest", "hop_index", "action_class", "operation_digest", "relation_id", "from_entity_id", "to_entity_id", "from_zone_id", "to_zone_id"],
      "properties": {
        "route_proposal_id": { "type": "string", "pattern": "^discovery-(?:theory|feedback-ranked)-route:[a-f0-9]{64}$" }, "route_digest": { "$ref": "#/$defs/digest" },
        "hop_index": { "const": 0 }, "action_class": { "$ref": "#/$defs/action_class" }, "operation_digest": { "$ref": "#/$defs/digest" },
        "relation_id": { "$ref": "#/$defs/id" }, "from_entity_id": { "$ref": "#/$defs/id" }, "to_entity_id": { "$ref": "#/$defs/id" },
        "from_zone_id": { "$ref": "#/$defs/id" }, "to_zone_id": { "$ref": "#/$defs/id" }
      }
    },
    "expected_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["state_digest", "entity_id", "zone_id"],
      "properties": { "state_digest": { "$ref": "#/$defs/digest" }, "entity_id": { "$ref": "#/$defs/id" }, "zone_id": { "$ref": "#/$defs/id" } }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": { "algorithm": { "const": "ed25519" }, "key_id": { "$ref": "#/$defs/id" }, "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" } }
    }
  }
}
