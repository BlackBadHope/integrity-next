{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/native-release-authority-enrollment.schema.json",
  "title": "Integrity native release authority enrollment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "instance_id", "authority", "created_at", "controls",
    "enrollment_id", "signature"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/native-release-authority-enrollment/v1" },
    "instance_id": { "type": "string", "pattern": "^instance:[a-z0-9][a-z0-9._-]{0,127}$" },
    "authority": { "$ref": "#/$defs/key" },
    "created_at": { "type": "string", "format": "date-time" },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_signing_only", "production_authority", "memory_grants_authority"
      ],
      "properties": {
        "manifest_signing_only": { "const": true },
        "production_authority": { "const": false },
        "memory_grants_authority": { "const": false }
      }
    },
    "enrollment_id": { "$ref": "#/$defs/digest" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "role", "algorithm", "public_key", "fingerprint"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "const": "release-authority" },
        "algorithm": { "const": "ed25519" },
        "public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "fingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
