{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v2/network-http-execution-receipt.schema.json",
  "title": "Integrity peer-authenticated loopback HTTP execution receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "protocol", "sdk_version", "envelope", "operation", "executor", "observed", "result", "controls", "recorded_at", "signer_id", "signature"],
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^network-execution:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/network-http-execution-receipt/v2" },
    "sdk_version": { "const": "1.0.0a2" },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_id", "envelope_digest"],
      "properties": {
        "envelope_id": { "type": "string", "pattern": "^envelope:[a-f0-9]{64}$" },
        "envelope_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["target_operation_id", "target_operation_digest", "action_id", "action_manifest_digest"],
      "properties": {
        "target_operation_id": { "type": "string", "pattern": "^adapter-target-operation:[a-f0-9]{64}$" },
        "target_operation_digest": { "$ref": "#/$defs/digest" },
        "action_id": { "type": "string", "pattern": "^network-action:[a-f0-9]{64}$" },
        "action_manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "executor": { "$ref": "#/$defs/executor" },
    "observed": {
      "type": "object", "additionalProperties": false,
      "required": ["request_sent", "connection_count", "request_count", "response_status", "response_content_type", "response_body_digest", "response_byte_count", "peer_key_id", "peer_key_fingerprint", "preflight_peer_receipt_id", "preflight_peer_receipt_digest", "preflight_peer_receipt", "response_peer_receipt_id", "response_peer_receipt_digest", "response_peer_receipt", "raw_body_retained"],
      "properties": {
        "request_sent": { "type": "boolean" },
        "connection_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "request_count": { "type": "integer", "minimum": 0, "maximum": 2 },
        "response_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "response_content_type": { "type": ["string", "null"], "maxLength": 128 },
        "response_body_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "response_byte_count": { "type": ["integer", "null"], "minimum": 0, "maximum": 4096 },
        "peer_key_id": { "$ref": "#/$defs/id" },
        "peer_key_fingerprint": { "$ref": "#/$defs/digest" },
        "preflight_peer_receipt_id": { "oneOf": [{ "$ref": "#/$defs/peer_receipt_id" }, { "type": "null" }] },
        "preflight_peer_receipt_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "preflight_peer_receipt": { "type": ["object", "null"] },
        "response_peer_receipt_id": { "oneOf": [{ "$ref": "#/$defs/peer_receipt_id" }, { "type": "null" }] },
        "response_peer_receipt_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "response_peer_receipt": { "type": ["object", "null"] },
        "raw_body_retained": { "const": false }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["reported_outcome", "reason_code", "peer_authenticated", "action_replayed", "automatic_retry_allowed"],
      "properties": {
        "reported_outcome": { "enum": ["reported-success", "reported-failure", "outcome-unknown"] },
        "reason_code": { "enum": ["expected-response-observed", "pre-request-network-failure", "peer-authentication-failed-before-action", "response-mismatch", "post-request-outcome-unknown"] },
        "peer_authenticated": { "type": "boolean" },
        "action_replayed": { "const": false },
        "automatic_retry_allowed": { "const": false }
      }
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["numeric_loopback_destination", "dns_resolution", "proxy", "redirects", "credentials", "peer_authentication", "action_preflight_required", "fresh_response_challenge_required", "home_input", "production_authority"],
      "properties": {
        "numeric_loopback_destination": { "const": true },
        "dns_resolution": { "const": false },
        "proxy": { "const": false },
        "redirects": { "const": false },
        "credentials": { "const": false },
        "peer_authentication": { "const": "ed25519-challenge-v1" },
        "action_preflight_required": { "const": true },
        "fresh_response_challenge_required": { "const": true },
        "home_input": { "const": false },
        "production_authority": { "const": false }
      }
    },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "peer_receipt_id": { "type": "string", "pattern": "^network-peer-response:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_id", "executor_artifact_digest", "key_id"],
      "properties": {
        "executor_id": { "$ref": "#/$defs/id" },
        "executor_artifact_digest": { "$ref": "#/$defs/digest" },
        "key_id": { "$ref": "#/$defs/id" }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
