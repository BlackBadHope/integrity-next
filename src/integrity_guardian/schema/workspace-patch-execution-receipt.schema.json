{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/workspace-patch-execution-receipt.schema.json",
  "title": "Integrity Workspace Patch execution receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["receipt_id", "protocol", "sdk_version", "envelope", "operation", "executor", "before", "after", "blast_radius", "result", "controls", "recorded_at", "signer_id", "signature"],
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^workspace-patch-execution:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/workspace-patch-execution-receipt/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_id", "envelope_digest"],
      "properties": {
        "envelope_id": { "type": "string", "pattern": "^envelope:[a-f0-9]{64}$" },
        "envelope_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["target_operation_id", "target_operation_digest", "patch_id", "patch_manifest_digest", "patch_digest"],
      "properties": {
        "target_operation_id": { "type": "string", "pattern": "^adapter-target-operation:[a-f0-9]{64}$" },
        "target_operation_digest": { "$ref": "#/$defs/digest" },
        "patch_id": { "type": "string", "pattern": "^workspace-patch:[a-f0-9]{64}$" },
        "patch_manifest_digest": { "$ref": "#/$defs/digest" },
        "patch_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_id", "executor_artifact_digest", "key_id"],
      "properties": {
        "executor_id": { "$ref": "#/$defs/id" },
        "executor_artifact_digest": { "$ref": "#/$defs/digest" },
        "key_id": { "$ref": "#/$defs/id" }
      }
    },
    "before": { "$ref": "#/$defs/state" },
    "after": { "oneOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] },
    "blast_radius": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_paths_digest", "allowed_path_count", "observed_paths_digest", "observed_path_count", "outside_allowed_count"],
      "properties": {
        "allowed_paths_digest": { "$ref": "#/$defs/digest" },
        "allowed_path_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "observed_paths_digest": { "$ref": "#/$defs/digest" },
        "observed_path_count": { "type": "integer", "minimum": 0, "maximum": 64 },
        "outside_allowed_count": { "const": 0 }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["reported_outcome", "reason_code", "expected_tree_observed", "action_replayed", "automatic_retry_allowed"],
      "properties": {
        "reported_outcome": { "enum": ["reported-success", "reported-failure", "outcome-unknown"] },
        "reason_code": { "enum": ["expected-tree-observed", "precondition-mismatch", "patch-rejected", "apply-failed", "postcondition-mismatch", "observer-unavailable"] },
        "expected_tree_observed": { "type": ["boolean", "null"] },
        "action_replayed": { "const": false },
        "automatic_retry_allowed": { "const": false }
      }
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["bwrap", "network", "credentials", "git_index_write", "git_remote", "production_authority"],
      "properties": {
        "bwrap": { "const": true }, "network": { "const": false },
        "credentials": { "const": false }, "git_index_write": { "const": false },
        "git_remote": { "const": false }, "production_authority": { "const": false }
      }
    },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "oid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["head_oid", "tree_oid", "state_digest", "clean"],
      "properties": {
        "head_oid": { "$ref": "#/$defs/oid" }, "tree_oid": { "$ref": "#/$defs/oid" },
        "state_digest": { "$ref": "#/$defs/digest" }, "clean": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" }, "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
