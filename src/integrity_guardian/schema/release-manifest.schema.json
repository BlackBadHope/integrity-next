{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/release-manifest.schema.json",
  "title": "Integrity Guardian Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "release_id",
    "version",
    "source_revision",
    "source_tree_digest",
    "artifact_count",
    "artifacts",
    "controls",
    "created_at",
    "authorization"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/release-manifest/v1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^release:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:(?:a|b|rc)[0-9]+|[.-][A-Za-z0-9.]+)?$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_tree_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_room",
        "credentials_included",
        "customer_data_included",
        "production_authority",
        "reproducible_build_required"
      ],
      "properties": {
        "clean_room": {
          "const": true
        },
        "credentials_included": {
          "const": false
        },
        "customer_data_included": {
          "const": false
        },
        "production_authority": {
          "const": false
        },
        "reproducible_build_required": {
          "const": true
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "decision",
        "signature"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "pattern": "^key:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "decision": {
          "const": "approved"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "size_bytes",
        "executable"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^key:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
