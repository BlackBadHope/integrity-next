{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/memory-link-context.schema.json",
  "title": "Bounded multi-hop canonical memory-link context pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "graph_digest", "source_namespace", "result", "anchor",
    "candidate_count", "candidates", "direction", "relations", "max_depth",
    "node_limit", "link_limit", "nodes", "links", "counts", "truncation",
    "max_context_bytes", "persistent_derived_state", "production_authority",
    "route_authority", "receipt_id"
  ],
  "properties": {
    "protocol": {"const": "integrity-guardian/memory-link-context/v1"},
    "graph_digest": {"$ref": "#/$defs/digest"},
    "source_namespace": {"type": "string", "pattern": "^seed://project/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "result": {"enum": ["PACKED", "ISOLATED", "AMBIGUOUS", "NOT_FOUND"]},
    "anchor": {"oneOf": [{"$ref": "#/$defs/node"}, {"type": "null"}]},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/node"}},
    "direction": {"enum": ["outbound", "inbound", "both"]},
    "relations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relation"}},
    "max_depth": {"type": "integer", "minimum": 1, "maximum": 4},
    "node_limit": {"type": "integer", "minimum": 1, "maximum": 200},
    "link_limit": {"type": "integer", "minimum": 1, "maximum": 200},
    "nodes": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/context_node"}},
    "links": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/context_link"}},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "returned_nodes", "omitted_nodes", "returned_links", "omitted_links",
        "expanded_nodes", "frontier_nodes", "max_reached_depth"
      ],
      "properties": {
        "returned_nodes": {"type": "integer", "minimum": 0, "maximum": 200},
        "omitted_nodes": {"type": "integer", "minimum": 0},
        "returned_links": {"type": "integer", "minimum": 0, "maximum": 200},
        "omitted_links": {"type": "integer", "minimum": 0},
        "expanded_nodes": {"type": "integer", "minimum": 0, "maximum": 200},
        "frontier_nodes": {"type": "integer", "minimum": 0},
        "max_reached_depth": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "truncation": {
      "type": "object", "additionalProperties": false,
      "required": ["truncated", "reasons"],
      "properties": {
        "truncated": {"type": "boolean"},
        "reasons": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["candidate-limit", "context-bytes", "depth-limit", "link-limit", "node-limit"]}
        }
      }
    },
    "max_context_bytes": {"type": "integer", "minimum": 8192, "maximum": 262144},
    "persistent_derived_state": {"const": false},
    "production_authority": {"const": false},
    "route_authority": {"const": false},
    "receipt_id": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "uri": {"type": "string", "pattern": "^integrity://seed/project/"},
    "relation": {"enum": ["blocks", "child-of", "cites", "concerns", "contradicts", "defines", "depends-on", "derived-from", "located-at", "preempts", "records-task", "refers-to", "related-to", "supports", "supersedes", "tagged-with"]},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "kind", "key", "title", "aliases", "alias_count", "omitted_alias_count", "source_event_ids", "source_event_count", "omitted_source_event_count"],
      "properties": {
        "uri": {"$ref": "#/$defs/uri"},
        "kind": {"enum": ["artifact", "component", "concept", "decision", "event", "evidence", "location", "release", "subsystem", "system", "task", "term"]},
        "key": {"type": "string", "minLength": 1, "maxLength": 512},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "aliases": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "alias_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "omitted_alias_count": {"type": "integer", "minimum": 0},
        "source_event_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "source_event_count": {"type": "integer", "minimum": 1},
        "omitted_source_event_count": {"type": "integer", "minimum": 0}
      }
    },
    "context_node": {
      "type": "object", "additionalProperties": false,
      "required": ["node", "depth", "predecessor_uri", "via_relation", "via_direction"],
      "properties": {
        "node": {"$ref": "#/$defs/node"},
        "depth": {"type": "integer", "minimum": 0, "maximum": 4},
        "predecessor_uri": {"oneOf": [{"$ref": "#/$defs/uri"}, {"type": "null"}]},
        "via_relation": {"oneOf": [{"$ref": "#/$defs/relation"}, {"type": "null"}]},
        "via_direction": {"enum": ["outbound", "inbound", null]}
      }
    },
    "context_link": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_uri", "relation", "target_uri", "provenance", "source_event_ids",
        "source_event_count", "omitted_source_event_count", "direction", "from_uri",
        "to_uri", "from_depth", "to_depth", "cycle", "follow_allowed"
      ],
      "properties": {
        "source_uri": {"$ref": "#/$defs/uri"},
        "relation": {"$ref": "#/$defs/relation"},
        "target_uri": {"$ref": "#/$defs/uri"},
        "provenance": {"enum": ["structured-seed", "explicit-memory-node", "explicit-memory-link"]},
        "source_event_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "source_event_count": {"type": "integer", "minimum": 1},
        "omitted_source_event_count": {"type": "integer", "minimum": 0},
        "direction": {"enum": ["outbound", "inbound"]},
        "from_uri": {"$ref": "#/$defs/uri"},
        "to_uri": {"$ref": "#/$defs/uri"},
        "from_depth": {"type": "integer", "minimum": 0, "maximum": 4},
        "to_depth": {"type": "integer", "minimum": 0, "maximum": 4},
        "cycle": {"type": "boolean"},
        "follow_allowed": {"type": "boolean"}
      }
    }
  }
}
