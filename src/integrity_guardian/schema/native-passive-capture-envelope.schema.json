{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/native-passive-capture-envelope.schema.json",
  "title": "Integrity Native Passive Capture Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "tenant_id",
    "capture_id",
    "capture_sequence",
    "platform_family",
    "platform_instance_id",
    "boot_identity_digest",
    "capture_started_at",
    "capture_completed_at",
    "collector_artifact_digest",
    "source_summaries",
    "boundary"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/native-passive-capture-envelope/v1"
    },
    "tenant_id": { "$ref": "#/$defs/tenant_id" },
    "capture_id": { "$ref": "#/$defs/id" },
    "capture_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "platform_family": {
      "enum": [
        "linux",
        "windows",
        "macos",
        "bsd",
        "posix-other",
        "unknown"
      ]
    },
    "platform_instance_id": { "$ref": "#/$defs/id" },
    "boot_identity_digest": { "$ref": "#/$defs/digest" },
    "capture_started_at": { "$ref": "#/$defs/timestamp" },
    "capture_completed_at": { "$ref": "#/$defs/timestamp" },
    "collector_artifact_digest": { "$ref": "#/$defs/digest" },
    "source_summaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/source_summary" }
    },
    "boundary": { "$ref": "#/$defs/boundary" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant:[A-Za-z0-9][A-Za-z0-9._:/-]{0,248}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_name",
        "status",
        "observed_at",
        "truncated",
        "record_count",
        "payload_digest",
        "coverage_digest",
        "reason_class"
      ],
      "properties": {
        "source_name": { "$ref": "#/$defs/id" },
        "status": {
          "enum": ["OBSERVED", "UNKNOWN", "DENIED"]
        },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "truncated": { "type": "boolean" },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "payload_digest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "coverage_digest": { "$ref": "#/$defs/digest" },
        "reason_class": {
          "oneOf": [
            {
              "enum": [
                "unknown-entity",
                "unknown-relation",
                "conflicting-identity",
                "unobserved-zone",
                "unsupported-protocol",
                "denied-coverage",
                "stale-source",
                "ambiguous-owner",
                "model-gap"
              ]
            },
            { "type": "null" }
          ]
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_probe",
        "atlas_admission",
        "checkpoint_commit",
        "collection_inside_core",
        "execution",
        "external_checkpoint_required",
        "memory_admission",
        "model_calls",
        "mutation",
        "network",
        "production_authority",
        "raw_rows_present"
      ],
      "properties": {
        "active_probe": { "const": false },
        "atlas_admission": { "const": false },
        "checkpoint_commit": { "const": false },
        "collection_inside_core": { "const": false },
        "execution": { "const": false },
        "external_checkpoint_required": { "const": true },
        "memory_admission": { "const": false },
        "model_calls": { "const": 0 },
        "mutation": { "const": false },
        "network": { "const": false },
        "production_authority": { "const": false },
        "raw_rows_present": { "const": false }
      }
    }
  }
}
