{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/toolz-post-route-feedback-receipt.schema.json",
  "title": "Integrity Uroboros Toolzs Post-Route Feedback Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "receipt_id",
    "tenant_id",
    "policy_id",
    "policy_digest",
    "theoretical_memory",
    "feedback_trace",
    "fog_route",
    "observed_memory",
    "decision",
    "causality",
    "created_at",
    "authority_boundary",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/toolz-post-route-feedback-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^toolz-post-route-feedback-receipt:[a-f0-9]{64}$"
    },
    "tenant_id": {
      "const": "tenant:public-6e3cdbebaafc8efa"
    },
    "policy_id": {
      "$ref": "#/$defs/synthetic_id"
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "theoretical_memory": {
      "$ref": "#/$defs/theoretical_memory"
    },
    "feedback_trace": {
      "$ref": "#/$defs/feedback_trace"
    },
    "fog_route": {
      "$ref": "#/$defs/fog_route"
    },
    "observed_memory": {
      "$ref": "#/$defs/observed_memory"
    },
    "decision": {
      "const": "admit-observed-success"
    },
    "causality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_created_at",
        "theoretical_memory_created_at",
        "feedback_trace_started_at",
        "feedback_trace_completed_at",
        "observed_memory_created_at",
        "feedback_created_at",
        "ordering"
      ],
      "properties": {
        "route_created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "theoretical_memory_created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "feedback_trace_started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "feedback_trace_completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "observed_memory_created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "feedback_created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ordering": {
          "const": "route-before-or-at-theoretical-memory-before-trace-start-before-trace-completion-before-or-at-observed-memory-before-or-at-feedback"
        }
      }
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_control",
        "credentials",
        "execution",
        "global_publish",
        "local_storage",
        "model_sdk",
        "network",
        "production_authority",
        "raw_ui_data",
        "retroactive_success",
        "store_write",
        "tool_invocation"
      ],
      "properties": {
        "browser_control": {
          "const": false
        },
        "credentials": {
          "const": false
        },
        "execution": {
          "const": false
        },
        "global_publish": {
          "const": false
        },
        "local_storage": {
          "const": false
        },
        "model_sdk": {
          "const": false
        },
        "network": {
          "const": false
        },
        "production_authority": {
          "const": false
        },
        "raw_ui_data": {
          "const": false
        },
        "retroactive_success": {
          "const": false
        },
        "store_write": {
          "const": false
        },
        "tool_invocation": {
          "const": false
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "synthetic_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}synthetic[A-Za-z0-9._:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic_entity": {
      "type": "string",
      "pattern": "^entity:synthetic-toolz-state-[a-f0-9]{64}$"
    },
    "relation_id": {
      "type": "string",
      "pattern": "^relation:synthetic-toolz-transition-[a-f0-9]{64}$"
    },
    "relation_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relation_id"
      }
    },
    "zone_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}synthetic[A-Za-z0-9._:/-]*$"
    },
    "zone_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/zone_id"
      }
    },
    "theoretical_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_digest",
        "policy_digest",
        "outcome",
        "observed_at",
        "evidence_digest",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^toolz-route-memory-receipt:[a-f0-9]{64}$"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "outcome": {
          "const": "theoretical"
        },
        "observed_at": {
          "type": "null"
        },
        "evidence_digest": {
          "type": "null"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "observed_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_digest",
        "policy_digest",
        "outcome",
        "observed_at",
        "evidence_digest",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^toolz-route-memory-receipt:[a-f0-9]{64}$"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "outcome": {
          "const": "observed-success"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "feedback_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "trace_digest",
        "policy_digest",
        "started_at",
        "completed_at",
        "from_entity_id",
        "to_entity_id",
        "entity_ids",
        "relation_ids",
        "hops",
        "invalidation_zone_ids"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^toolz-action-trace:[a-f0-9]{64}$"
        },
        "trace_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "from_entity_id": {
          "$ref": "#/$defs/synthetic_entity"
        },
        "to_entity_id": {
          "$ref": "#/$defs/synthetic_entity"
        },
        "entity_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 33,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/synthetic_entity"
          }
        },
        "relation_ids": {
          "$ref": "#/$defs/relation_ids"
        },
        "hops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/trace_hop"
          }
        },
        "invalidation_zone_ids": {
          "$ref": "#/$defs/zone_ids"
        }
      }
    },
    "trace_hop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "from_entity_id",
        "to_entity_id",
        "from_zone_id",
        "to_zone_id",
        "observed_at",
        "evidence_digest",
        "confidence_ppm"
      ],
      "properties": {
        "relation_id": {
          "$ref": "#/$defs/relation_id"
        },
        "from_entity_id": {
          "$ref": "#/$defs/synthetic_entity"
        },
        "to_entity_id": {
          "$ref": "#/$defs/synthetic_entity"
        },
        "from_zone_id": {
          "$ref": "#/$defs/zone_id"
        },
        "to_zone_id": {
          "$ref": "#/$defs/zone_id"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "confidence_ppm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "fog_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "route_digest",
        "snapshot_id",
        "snapshot_digest",
        "route_created_at",
        "from_entity_id",
        "to_entity_id",
        "entity_ids",
        "relation_ids",
        "invalidation_zone_ids"
      ],
      "properties": {
        "proposal_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^discovery-theory-route:[a-f0-9]{64}$"
            },
            {
              "type": "string",
              "pattern": "^discovery-feedback-ranked-route:[a-f0-9]{64}$"
            }
          ]
        },
        "route_digest": {
          "$ref": "#/$defs/digest"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^discovery-index-snapshot:[a-f0-9]{64}$"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "route_created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "from_entity_id": {
          "$ref": "#/$defs/synthetic_entity"
        },
        "to_entity_id": {
          "$ref": "#/$defs/synthetic_entity"
        },
        "entity_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 33,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/synthetic_entity"
          }
        },
        "relation_ids": {
          "$ref": "#/$defs/relation_ids"
        },
        "invalidation_zone_ids": {
          "$ref": "#/$defs/zone_ids"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^key:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
