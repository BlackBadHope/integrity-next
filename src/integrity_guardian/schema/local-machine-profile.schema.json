{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/local-machine-profile.schema.json",
  "title": "Integrity local machine profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "profile_id",
    "tenant",
    "seed",
    "runtime",
    "created_at",
    "controls"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/local-machine-profile/v1" },
    "profile_id": { "type": "string", "pattern": "^local-profile:[a-f0-9]{64}$" },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "state_root"],
      "properties": {
        "tenant_id": { "type": "string", "pattern": "^tenant:[a-z0-9][a-z0-9._-]{0,63}$" },
        "state_root": { "$ref": "#/$defs/path" }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "source_namespace"],
      "properties": {
        "catalog": { "$ref": "#/$defs/path" },
        "source_namespace": {
          "type": "string",
          "pattern": "^seed://project/[a-z0-9][a-z0-9._-]{0,127}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "persistence_task"],
      "properties": {
        "host": { "enum": ["127.0.0.1", "::1"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "persistence_task": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
          ]
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imports_remote_memory",
        "forbidden_context_ports",
        "loopback_only",
        "production_authority"
      ],
      "properties": {
        "imports_remote_memory": { "const": false },
        "forbidden_context_ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "uniqueItems": true
        },
        "loopback_only": { "const": true },
        "production_authority": { "const": false }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
  }
}
