{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/cognitive-continuation.schema.json",
  "title": "Atlas Cognitive Continuation Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "package_id",
    "tenant_id",
    "module_id",
    "agent_id",
    "agent_key_id",
    "generation",
    "lease_id",
    "lease_head_id",
    "lease_head_revision",
    "event_cursor",
    "state_digest",
    "atlas_projection_id",
    "route_id",
    "source_model_id",
    "target_model_id",
    "target_tier",
    "target_reasoning",
    "unresolved_questions",
    "stop_conditions",
    "budgets",
    "production_authority"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/cognitive-continuation/v1" },
    "package_id": {
      "type": "string",
      "pattern": "^continuation:[a-f0-9]{64}$"
    },
    "tenant_id": { "$ref": "#/$defs/tenant_id" },
    "module_id": { "$ref": "#/$defs/id" },
    "agent_id": { "$ref": "#/$defs/id" },
    "agent_key_id": { "$ref": "#/$defs/id" },
    "generation": { "type": "integer", "minimum": 0 },
    "lease_id": { "$ref": "#/$defs/id" },
    "lease_head_id": {
      "type": "string",
      "pattern": "^lease-head:[a-f0-9]{64}$"
    },
    "lease_head_revision": { "type": "integer", "minimum": 0 },
    "event_cursor": { "type": "integer", "minimum": 0 },
    "state_digest": { "$ref": "#/$defs/digest" },
    "atlas_projection_id": { "$ref": "#/$defs/id" },
    "route_id": { "$ref": "#/$defs/id" },
    "source_model_id": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "target_model_id": { "$ref": "#/$defs/id" },
    "target_tier": { "enum": ["L1", "L2", "L3"] },
    "target_reasoning": {
      "enum": ["minimal", "low", "medium", "high", "maximum"]
    },
    "unresolved_questions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_model_calls",
        "max_specialist_agents"
      ],
      "properties": {
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_model_calls": { "const": 1 },
        "max_specialist_agents": { "type": "integer", "minimum": 0, "maximum": 16 }
      }
    },
    "production_authority": { "const": false }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant:[A-Za-z0-9][A-Za-z0-9._:/-]{0,248}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
