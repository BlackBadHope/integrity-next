{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/toolz-authorization-request.schema.json",
  "title": "Integrity Uroboros Toolzs Authorization Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "tenant_id",
    "policy_id",
    "policy_digest",
    "status",
    "requester",
    "decision_authority",
    "readiness",
    "intent",
    "scope",
    "timing",
    "privacy_boundary",
    "authority_boundary",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "integrity-guardian/toolz-authorization-request/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^toolz-authorization-request:[a-f0-9]{64}$"
    },
    "tenant_id": {
      "const": "tenant:public-6e3cdbebaafc8efa"
    },
    "policy_id": {
      "$ref": "#/$defs/synthetic_id"
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "status": {
      "const": "pending-authority-decision"
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requester_id",
        "requester_artifact_digest"
      ],
      "properties": {
        "requester_id": {
          "$ref": "#/$defs/synthetic_id"
        },
        "requester_artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "decision_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_artifact_digest"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/synthetic_id"
        },
        "authority_artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_digest",
        "policy_digest",
        "witness_id",
        "expires_at"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^toolz-reuse-readiness-receipt:[a-f0-9]{64}$"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "witness_id": {
          "type": "string",
          "pattern": "^toolz-start-state-witness:[a-f0-9]{64}$"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_proposal_id",
        "route_digest",
        "hop_index",
        "action_class",
        "operation_digest",
        "relation_id",
        "from_entity_id",
        "to_entity_id",
        "from_zone_id",
        "to_zone_id"
      ],
      "properties": {
        "route_proposal_id": {
          "type": "string",
          "pattern": "^discovery-(?:theory|feedback-ranked)-route:[a-f0-9]{64}$"
        },
        "route_digest": {
          "$ref": "#/$defs/digest"
        },
        "hop_index": {
          "const": 0
        },
        "action_class": {
          "enum": [
            "observe",
            "navigate",
            "activate",
            "input",
            "submit",
            "wait",
            "external-call"
          ]
        },
        "operation_digest": {
          "$ref": "#/$defs/digest"
        },
        "relation_id": {
          "$ref": "#/$defs/id"
        },
        "from_entity_id": {
          "$ref": "#/$defs/id"
        },
        "to_entity_id": {
          "$ref": "#/$defs/id"
        },
        "from_zone_id": {
          "$ref": "#/$defs/synthetic_id"
        },
        "to_zone_id": {
          "$ref": "#/$defs/synthetic_id"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_capability",
        "max_transitions",
        "replay_allowed",
        "route_continuation_allowed",
        "production_authority_requested"
      ],
      "properties": {
        "requested_capability": {
          "const": "single-toolz-transition"
        },
        "max_transitions": {
          "const": 1
        },
        "replay_allowed": {
          "const": false
        },
        "route_continuation_allowed": {
          "const": false
        },
        "production_authority_requested": {
          "const": false
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_at",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "requested_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "privacy_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cookies",
        "credentials",
        "dom",
        "form_values",
        "free_text",
        "operation_parameters",
        "screenshots",
        "selectors",
        "urls"
      ],
      "properties": {
        "cookies": {
          "const": false
        },
        "credentials": {
          "const": false
        },
        "dom": {
          "const": false
        },
        "form_values": {
          "const": false
        },
        "free_text": {
          "const": false
        },
        "operation_parameters": {
          "const": false
        },
        "screenshots": {
          "const": false
        },
        "selectors": {
          "const": false
        },
        "urls": {
          "const": false
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_decided",
        "authorization_granted",
        "browser_control",
        "credentials",
        "execution",
        "global_publish",
        "local_storage_read",
        "model_sdk",
        "network",
        "production_authority",
        "raw_ui_data",
        "request_created",
        "request_transport_performed",
        "storage_performed",
        "store_write",
        "tool_invocation"
      ],
      "properties": {
        "authorization_decided": {
          "const": false
        },
        "authorization_granted": {
          "const": false
        },
        "browser_control": {
          "const": false
        },
        "credentials": {
          "const": false
        },
        "execution": {
          "const": false
        },
        "global_publish": {
          "const": false
        },
        "local_storage_read": {
          "const": true
        },
        "model_sdk": {
          "const": false
        },
        "network": {
          "const": false
        },
        "production_authority": {
          "const": false
        },
        "raw_ui_data": {
          "const": false
        },
        "request_created": {
          "const": true
        },
        "request_transport_performed": {
          "const": false
        },
        "storage_performed": {
          "const": false
        },
        "store_write": {
          "const": false
        },
        "tool_invocation": {
          "const": false
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "synthetic_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,128}$"
        }
      }
    }
  }
}
