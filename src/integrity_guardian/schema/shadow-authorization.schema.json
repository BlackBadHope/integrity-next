{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian/schema/v1/shadow-authorization.schema.json",
  "title": "Guardian Production Shadow Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "authorization_id",
    "tenant_id",
    "target_id",
    "release_revision",
    "config_digest",
    "coverage",
    "budgets",
    "controls",
    "external_checkpoint",
    "created_at",
    "valid_from",
    "valid_until",
    "authorization"
  ],
  "properties": {
    "protocol": { "const": "integrity-guardian/shadow-authorization/v1" },
    "authorization_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "target_id": { "$ref": "#/$defs/id" },
    "release_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "config_digest": { "$ref": "#/$defs/digest" },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rss_mib",
        "max_cpu_basis_points",
        "max_queue_events",
        "max_local_bytes",
        "scan_interval_seconds"
      ],
      "properties": {
        "max_rss_mib": { "type": "integer", "minimum": 16, "maximum": 256 },
        "max_cpu_basis_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_queue_events": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_local_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "scan_interval_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "remediation_enabled",
        "baseline_auto_promotion"
      ],
      "properties": {
        "read_only": { "const": true },
        "remediation_enabled": { "const": false },
        "baseline_auto_promotion": { "const": false }
      }
    },
    "external_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "store_id", "retention_days"],
      "properties": {
        "required": { "const": true },
        "store_id": { "$ref": "#/$defs/id" },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "valid_until": { "$ref": "#/$defs/timestamp" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "decision", "signature"],
      "properties": {
        "authority_id": { "$ref": "#/$defs/id" },
        "decision": { "const": "approved" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
