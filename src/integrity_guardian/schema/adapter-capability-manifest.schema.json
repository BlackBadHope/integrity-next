{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrity.guardian.invalid/schema/v1/adapter-capability-manifest.schema.json",
  "title": "Integrity Adapter SDK Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id", "protocol", "sdk_version", "adapter_id", "adapter_version",
    "adapter_artifact_digest", "roles", "action_classes", "declared_channels",
    "interface_contract", "limits", "created_at", "signer_id", "signature"
  ],
  "properties": {
    "manifest_id": { "type": "string", "pattern": "^manifest:[a-f0-9]{64}$" },
    "protocol": { "const": "integrity-guardian/adapter-capability-manifest/v1" },
    "sdk_version": { "const": "1.0.0a2" },
    "adapter_id": { "$ref": "#/$defs/id" },
    "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:a[0-9]+)?$" },
    "adapter_artifact_digest": { "$ref": "#/$defs/digest" },
    "roles": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": { "enum": ["observer", "executor", "witness"] }
    },
    "action_classes": {
      "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
      "items": { "$ref": "#/$defs/action_class" }
    },
    "declared_channels": { "$ref": "#/$defs/channels" },
    "interface_contract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "request_schema_digest", "observation_schema_digest", "result_schema_digest",
        "max_timeout_seconds", "max_output_bytes", "credential_delivery"
      ],
      "properties": {
        "request_schema_digest": { "$ref": "#/$defs/digest" },
        "observation_schema_digest": { "$ref": "#/$defs/digest" },
        "result_schema_digest": { "$ref": "#/$defs/digest" },
        "max_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "credential_delivery": { "enum": ["none", "reference-only"] }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": [
        "max_transitions_per_grant", "replay_allowed",
        "automatic_retry_after_unknown", "route_memory_write", "production_authority"
      ],
      "properties": {
        "max_transitions_per_grant": { "const": 1 },
        "replay_allowed": { "const": false },
        "automatic_retry_after_unknown": { "const": false },
        "route_memory_write": { "const": false },
        "production_authority": { "const": false }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "signer_id": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "action_class": { "enum": ["observe", "navigate", "activate", "input", "submit", "wait", "external-call"] },
    "channels": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "browser_control", "computer_use", "credentials", "network", "service_control", "shell"],
      "properties": {
        "api": { "type": "boolean" },
        "browser_control": { "type": "boolean" },
        "computer_use": { "type": "boolean" },
        "credentials": { "type": "boolean" },
        "network": { "type": "boolean" },
        "service_control": { "type": "boolean" },
        "shell": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" }
      }
    }
  }
}
